        {"case_id": "breadth_below_threshold", "description": "Broad participation is below the frozen threshold", "expected_value": "weak", "evidence_ref": "tests/unit/test_governed_strategy.py"},
        {"case_id": "breadth_equal_threshold", "description": "Equality at the frozen threshold remains supportive", "expected_value": "supportive", "evidence_ref": "tests/unit/test_governed_strategy.py"}
      ],
      "expected_frequency": {"minimum_rate": "0.95", "maximum_rate": "1.00", "sample_scope": "governed_candidate_scan"},
      "validation_sample_refs": ["tests/unit/test_governed_strategy.py"]
