      "parameters": {"policy_binding": "candidate.market-breadth-trend-breakout@1.0.0"},
      "lookback_sessions": 60,
      "minimum_history_sessions": 60,
      "mutually_exclusive_with": [],
      "coexists_with": [],
      "output_values": ["supportive", "weak"],
      "evidence_fields": ["breadth", "minimum_breadth"],
      "reason_codes": ["breadth_supportive", "breadth_weak", "feature_unavailable"],
