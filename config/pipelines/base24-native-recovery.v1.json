{
  "schema_version": "quanthus.base24-native-recovery.v1",
  "policy_id": "p10-native-capture-resume-v1",
  "requires_recovery_mode": true,
  "max_resume_batches_per_date": 1,
  "max_seconds_per_batch": 3600,
  "max_seed_bytes": 268435456,
  "native_workers_max": 2,
  "failure_reason": "DAILY_CYCLE_NATIVE_CAPTURE_INCOMPLETE",
  "reuse": "verified independent source bytes; completed securities are never requested again",
  "deadline_disposition": "LATE_RECOVERY_NOT_ON_TIME_SUCCESS",
  "full_daily_reacquisition": false,
  "consumer_admission": "UNCHANGED",
  "login_only_repair": {
    "max_batches": 1,
    "max_failed_shards": 4,
    "max_seconds": 900,
    "deadline": "within original resume capture UTC + max_seconds; no extra hour",
    "source_rows_before_retry": 0,
    "preserve_original_failed_logs": true
  }
}
