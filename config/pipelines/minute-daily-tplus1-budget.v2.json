{
  "schema_version": 2,
  "policy_id": "p10-1m-daily-and-tplus1-bounded-ops-v2",
  "authority": "P10 #495 / #505; Owner 2026-10-09 clarification: sixty minutes gates new operations, never kills in-flight",
  "status": "governance_accepted_runtime_activation_separately_gated",
  "product_scope": "optional_source_native_1m_only",
  "timezone": "Asia/Shanghai",
  "per_target_market_date": {
    "T": {
      "phase": "same_exchange_trading_session",
      "eligible_after": "session_completed_and_source_current_date_present",
      "allowed": "raw_capture_initial_grade_and_versioned_research_ODS_DWD_if_qualified",
      "new_operation_admission_cutoff_seconds": 3600,
      "cutoff_semantics": "reject_new_operation_at_or_after_3600_seconds_of_cumulative_phase_execution",
      "admitted_inflight_operation_can_finish": true,
      "must_not_interrupt_at_cutoff": true,
      "late_new_retries_and_new_batches_forbidden": true,
      "routine_target_new_operation_admission_seconds": 1800
    },
    "T_plus_1": {
      "phase": "calendar_day_after_verified_market_T",
      "eligible_after": "calendar_day_after_verified_market_T_and_source_maturity_probe",
      "allowed": "target_date_only_recheck_source_revision_and_bounded_remedial_correction",
      "split_across_checks_allowed": true,
      "window_not_reset_by_retry_or_midnight": true,
      "source_maturity_probe_min_symbols": 12,
      "source_maturity_probe_max_symbols": 24,
      "source_revision_comparison": "per_symbol_target_market_date_native_1m_observation_digest_not_full_rolling_800_bar_response_sha256",
      "narrow_repoll_only_after": "proved_target_date_revision_or_new_reliable_source_evidence",
      "no_new_evidence_action": "stop_without_spending_remaining_budget",
      "recovery_date_semantics": "next_calendar_day_of_verified_market_T_including_weekends",
      "new_operation_admission_cutoff_seconds": 3600,
      "cutoff_semantics": "reject_new_operation_at_or_after_3600_seconds_of_cumulative_phase_execution",
      "admitted_inflight_operation_can_finish": true,
      "must_not_interrupt_at_cutoff": true,
      "late_new_retries_and_new_batches_forbidden": true
    },
    "expired_next_day_action": "no_automatic_T_plus_2_retries_register_separate_business_value_justified_recovery",
    "combined_new_operation_admission_window_seconds": 7200,
    "combined_window_is_not_hard_wall_completion_deadline": true,
    "post_cutoff_drain_may_exceed_window": "only_already_started_bounded_atomic_operation_until_its_own_timeout_or_completion"
  },
  "immutable_accounting": {
    "key": [
      "market_date",
      "phase",
      "policy_id"
    ],
    "fields": [
      "attempt_id",
      "started_at",
      "finished_at",
      "elapsed_wall_seconds",
      "cumulative_wall_seconds",
      "provider_request_count",
      "target_date_observation_digest_before",
      "target_date_observation_digest_after",
      "raw_response_sha256",
      "changed_securities",
      "grade_counts_before",
      "grade_counts_after",
      "new_release_manifest_sha256",
      "stop_reason",
      "operation_id",
      "operation_kind",
      "operation_timeout_seconds",
      "operation_admitted_at",
      "phase_consumed_seconds_at_admission",
      "operation_started_at",
      "operation_finished_at",
      "operation_completed_after_cutoff",
      "post_cutoff_drain_seconds",
      "phase_cumulative_actual_elapsed_seconds"
    ],
    "shared_attempt_budget_not_reinitialized_by_restart": true,
    "lock_scope": "single_market_date_phase",
    "source_revisions_as_new_versioned_corrections_not_overwrite": true,
    "knowledge_time_actual_acquisition_never_backdated": true,
    "time_budget_semantics": "cumulative_processing_time_new_operation_admission_gate_not_global_termination",
    "admission_checked_at_real_operation_start": true,
    "phase_consumed_processing_time_persisted_after_each_atomic_operation": true,
    "account_post_cutoff_tail_in_actual_elapsed": true,
    "restarts_cannot_reopen_admission_after_threshold": true
  },
  "grade_admission": {
    "R0": "formal_ODS_DWD_and_restricted_research",
    "R1": "formal_ODS_DWD_observed_only_defect_record_and_gap_aware_research",
    "R2": "formal_ODS_DWD_observed_only_quality_reasons_and_explicit_consumer_restriction",
    "R3": "no_formal_ODS_DWD_original_raw_or_ohlcv_quarantine_evidence_only_with_rejection_metadata",
    "SUSPENDED": "status_metadata_only_no_minute_bars",
    "prerequisites": [
      "versioned_R2_R3_ingestion_contract_503",
      "source_SHA_PIT_identity_units_invariants"
    ]
  },
  "independence": {
    "daily_core_unblocked_by_1m": true,
    "native_5m_independent_status": true,
    "legacy_four_lane_unchanged": true,
    "formal_consumer_admission_separate": true,
    "no_P3_P5_protected_research_or_P6_auto_activation": true
  },
  "review_after_completed_market_sessions": 10,
  "rollout_gate": "versioned_runtime_controller_tests_59m59s_plus_inflight_drain_isolated_Linux_replay_and_separate_production_cutover",
  "supersedes_policy_id": "p10-1m-daily-and-tplus1-bounded-ops-v1",
  "atomic_operation": {
    "definition": "one_bounded_indivisible_stage_such_as_actual_security_shard_fetch_or_atomic_manifest_publication_with_its_validation",
    "real_start_required_before_cutoff": true,
    "queueing_or_reserving_future_operations_before_cutoff_is_not_real_start": true,
    "no_unbounded_whole_market_or_multi_day_operation": true,
    "must_have_individual_timeout": true,
    "max_operation_timeout_seconds": 600,
    "operation_timeout_budget_counts_from_actual_start": true,
    "already_started_operation_finalization_allowed_after_cutoff": true,
    "no_new_retry_or_next_shard_after_cutoff": true,
    "atomic_commit_and_invariant_verification_within_same_admitted_operation": true,
    "failed_operation_can_only_be_logged_and_compensated_without_starting_new_work_after_cutoff": true,
    "resource_lock": "single_operation_per_market_date_phase"
  }
}
