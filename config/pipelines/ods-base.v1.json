    "scope_gaps": [
      {
        "dataset_family": "raw_f10_and_full_financial_statements",
        "classification": "not_formally_acquired",
        "reason": "Hermes currently retains a governed quarterly financial summary but no immutable raw F10 text or complete balance-sheet, income-statement, and cash-flow archive",
        "downstream_impact": "The Base can reproduce the accepted financial_quarterly summary only; full-statement or F10 research requires a separately governed acquisition and a new Base revision"
      }
    ],
    "exclusions": [
      {"pattern": "data/*.bak*", "classification": "excluded_backup", "reason": "superseded mutable-file backup"},
      {"pattern": "data/cutover", "classification": "excluded_cutover_evidence", "reason": "deployment evidence is not ODS payload"},
      {"pattern": "data/errors.json", "classification": "excluded_failed_attempt_state", "reason": "collector failure state is not Base payload"},
      {"pattern": "data/hist_*", "classification": "excluded_superseded_working_data", "reason": "historical repair workspace is represented by accepted canonical files"},
      {"pattern": "data/landing", "classification": "excluded_staging", "reason": "mutable landing workspace is not an accepted Base member"},
      {"pattern": "data/pipeline_status.json", "classification": "excluded_operational_state", "reason": "mutable scheduler status is not Base payload"},
      {"pattern": "data/progress.json*", "classification": "excluded_operational_state", "reason": "mutable collector checkpoint is replaced by the Base manifest"},
      {"pattern": "data/qa_data_gaps.parquet", "classification": "excluded_derived_quality", "reason": "derived quality output belongs downstream of ODS"},
      {"pattern": "data/ref_tradability_*", "classification": "excluded_derived_curated_data", "reason": "tradability coverage/enrichment belongs to DWD"},
      {"pattern": "data/releases", "classification": "excluded_legacy_release_root", "reason": "legacy releases are superseded by selected repository-owned shadow releases"},
      {"pattern": "data/revisions", "classification": "excluded_superseded_revisions", "reason": "accepted canonical bytes are included; revision workspaces remain separate evidence"},
      {"pattern": "data/shadow", "classification": "mixed_selected_release_root", "reason": "only selected complete Hermes daily attempts are included"},
      {"pattern": "data/temp_*", "classification": "excluded_temporary", "reason": "temporary acquisition files are not accepted Base payload"},
      {"pattern": "data/tradability_overrides_20241106.parquet", "classification": "excluded_derived_exception", "reason": "curated tradability override belongs to DWD policy/evidence"},
      {"pattern": "minute/data/*.json", "classification": "excluded_operational_state", "reason": "root-level minute smoke/checkpoint state is not formal archive data"},
      {"pattern": "minute/data/*.meta.json", "classification": "excluded_smoke_fixture", "reason": "root-level minute sample metadata is not formal archive data"},
      {"pattern": "minute/data/*.parquet", "classification": "excluded_smoke_fixture", "reason": "root-level minute samples are outside prod_5m and research_1m"}
    ]
  },
  "retention": {
    "migration_mode": "copy_only",
    "delete_enabled": false,
    "minimum_identical_copies": 2
  }
}
