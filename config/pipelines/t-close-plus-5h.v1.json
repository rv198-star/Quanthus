{
  "schema_version": 1,
  "pipeline_id": "t-close-plus-5h-v1",
  "timezone": "Asia/Shanghai",
  "close_time": "15:30:00",
  "completion_sla_minutes": 116,
  "stage_sla_margin_percent": 100,
  "run_root": "{warehouse_root}/runs",
  "lock_path": "{warehouse_root}/locks/t-close-plus-5h.lock",
  "variables": {
    "repo_root": {
      "environment": "QUANTHUS_REPO_ROOT",
      "default": "/opt/quanthus/current"
    },
    "python": {
      "environment": "QUANTHUS_PYTHON",
      "default": "/opt/quanthus/current/.venv/bin/python"
    },
    "code_revision": {
      "environment": "QUANTHUS_CODE_REVISION"
    },
    "ods_root": {
      "environment": "QUANTHUS_ODS_ROOT",
      "default": "/home/ubuntu/data/astock"
    },
    "warehouse_root": {
      "environment": "QUANTHUS_WAREHOUSE_ROOT",
      "default": "/home/ubuntu/data/quanthus"
    }
  },
  "stages": [
    {
      "id": "wait_daily_ods_source_ready",
      "phase": "acquire",
      "kind": "command",
      "argv": [
        "{repo_root}/ops/bin/wait-ods-release-ready",
        "daily",
        "{market_date}",
        "{run_dir}/ods-source-selection.json",
        "6277",
        "30"
      ],
      "timeout_seconds": 6300,
      "observed_max_duration_seconds": 3138.4
    },
    {
      "id": "pull_hermes_daily_release",
      "phase": "acquire",
      "kind": "command",
      "argv": [
        "{repo_root}/ops/bin/pull-ods-release",
        "daily",
        "{market_date}",
        "{ods_root}",
        "{run_dir}/ods-source-selection.json"
      ],
      "retries": 0,
      "timeout_seconds": 660,
      "dynamic_sla_receipt_path": "{run_dir}/ods-source-selection.json"
    },
    {
      "id": "verify_hermes_daily_release",
      "phase": "verify",
      "kind": "verify_ods_release",
      "release_dir": "{ods_root}/releases/daily/{market_date}",
      "retries": 1,
      "retry_delay_seconds": 60,
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.009
    },
    {
      "id": "check_market_session",
      "phase": "verify",
      "kind": "market_session_check",
      "calendar_path": "{ods_root}/releases/daily/{market_date}/artifacts/ref_trading_calendar.parquet",
      "timeout_seconds": 300,
      "observed_max_duration_seconds": 0.407
    },
    {
      "id": "build_daily_dwd_partition",
      "phase": "build",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "build-daily-dwd",
        "--release-dir",
        "{ods_root}/releases/daily/{market_date}",
        "--output",
        "{warehouse_root}/revisions/daily_market_dwd_v1_{market_date_compact}_{run_id}",
        "--revision",
        "daily_market_dwd_v1_{market_date_compact}_{run_id}",
        "--market-date",
        "{market_date}",
        "--universe-policy",
        "{repo_root}/config/p1-universe.v2.json",
        "--code-validity-mapping",
        "{repo_root}/config/security-code-validity.v1.json",
        "--code-revision",
        "{code_revision}",
        "--parent-pointer",
        "{warehouse_root}/revisions/daily_market_CURRENT.json",
        "--base-pointer",
        "{warehouse_root}/revisions/daily_ohlcv_none_CURRENT.json"
      ],
      "timeout_seconds": 1800,
      "observed_max_duration_seconds": 1.373
    },
    {
      "id": "build_daily_dws_summary",
      "phase": "build",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "build-daily-dws",
        "--dwd-revision-dir",
        "{warehouse_root}/revisions/daily_market_dwd_v1_{market_date_compact}_{run_id}",
        "--output",
        "{warehouse_root}/revisions/daily_market_dws_v1_{market_date_compact}_{run_id}",
        "--revision",
        "daily_market_dws_v1_{market_date_compact}_{run_id}",
        "--market-date",
        "{market_date}"
      ],
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.267
    },
    {
      "id": "gate_daily_dwd_partition",
      "phase": "gate",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "check-daily-dwd",
        "--revision-dir",
        "{warehouse_root}/revisions/daily_market_dwd_v1_{market_date_compact}_{run_id}"
      ],
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.167
    },
    {
      "id": "gate_daily_dws_summary",
      "phase": "gate",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "check-daily-dws",
        "--revision-dir",
        "{warehouse_root}/revisions/daily_market_dws_v1_{market_date_compact}_{run_id}"
      ],
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.217
    },
    {
      "id": "publish_daily_dwd_current",
      "phase": "publish",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "promote-daily-dwd",
        "--revision-dir",
        "{warehouse_root}/revisions/daily_market_dwd_v1_{market_date_compact}_{run_id}",
        "--pointer",
        "{warehouse_root}/revisions/daily_market_CURRENT.json"
      ],
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.168
    },
    {
      "id": "publish_daily_dws_current",
      "phase": "publish",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "quanthus",
        "promote-daily-dws",
        "--revision-dir",
        "{warehouse_root}/revisions/daily_market_dws_v1_{market_date_compact}_{run_id}",
        "--pointer",
        "{warehouse_root}/revisions/daily_market_summary_CURRENT.json"
      ],
      "timeout_seconds": 900,
      "observed_max_duration_seconds": 0.217
    }
  ]
}
