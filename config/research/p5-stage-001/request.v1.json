      "any_frozen_head_metric_unavailable": "INCONCLUSIVE"
    },
    "line_level_metric_construction": {
      "pairing_unit": "same historical_stage_code plus same reference episode/sample identity",
      "common_case_rule": "within each frozen head, candidate and comparator are evaluated on the identical reference-eligible definite applicable evaluation cases; metric construction uses only cases with both required predictions, while raw-score/probability coverage is reported against the full frozen applicable denominator",
      "missing_case_rule": "missing prediction is never converted to a correct/incorrect pseudo-value; coverage records it; if paired metric eligibility falls below the frozen gate or any frozen head cannot produce the required metric, line-level disposition is INCONCLUSIVE",
      "head_weighting": "equal_weight_macro_over_the_exact_B_frozen_confirmatory_head_set",
