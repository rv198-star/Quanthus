    "observed_stage_0_false_positive_pattern": "coherent directional repricing or correction was mistaken for direction-neutral instability",
    "reference_protocol_defect": "explicit 10-session recent conditions were allowed to influence the 20-session primary judgement in at least 21 ambiguous cases"
  },
  "semantic_decomposition": {
    "primary_scale_sessions": 20,
    "recent_scale_sessions": 10,
