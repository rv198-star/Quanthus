      "structural_instability_20",
      "coherent_directional_relocation_20",
      "orderly_consolidation_20"
    ],
    "truth_values": ["TRUE", "FALSE", "UNKNOWN"],
    "stage_0_requires": {
      "structural_instability_20": "TRUE",
      "coherent_directional_relocation_20": "FALSE",
      "orderly_consolidation_20": "FALSE"
    },
    "stage_2_requires": {
      "structural_instability_20": "FALSE",
      "coherent_directional_relocation_20": "FALSE",
      "orderly_consolidation_20": "TRUE"
    },
    "directional_relocation_is_a_stage_0_guard": true,
    "directional_relocation_is_not_stage_0": true,
    "directional_relocation_is_not_automatically_stage_12": true,
    "positive_instability_plus_positive_relocation": "outside_stage_0_2_scope_with_mixed_directional_instability_reason",
    "unknown_relocation_with_positive_instability": "AMBIGUOUS",
    "role_level_resolution_precedence": [
      "INPUT_UNAVAILABLE if primary evidence is unavailable",
      "AMBIGUOUS_CONFLICT if orderly_consolidation_20 is TRUE together with structural_instability_20 TRUE or coherent_directional_relocation_20 TRUE",
      "STAGE_0 only for instability TRUE, relocation FALSE, order FALSE",
      "STAGE_2 only for instability FALSE, relocation FALSE, order TRUE",
      "NEITHER when coherent_directional_relocation_20 is TRUE and orderly_consolidation_20 is FALSE; retain mixed_directional_instability when instability is also TRUE",
      "NEITHER when structural_instability_20 is FALSE and orderly_consolidation_20 is FALSE",
      "AMBIGUOUS for all remaining UNKNOWN-dependent combinations"
    ],
    "cross_role_resolution": "if the two semantic roles do not produce the same primary status, retain AMBIGUOUS and preserve both atomic ledgers; no majority or adjudication",
    "residual_stage_0_forbidden": true,
    "top_1_force_forbidden": true
  },
  "fact_design": {
    "reuse_without_duplication": [
      "structure.geometry.window-return@20",
      "structure.geometry.directional-efficiency@20",
      "structure.geometry.range-width@20",
      "structure.geometry.width-change@20_vs_prior20",
      "structure.geometry.range-center-shift@20_vs_prior20"
    ],
    "proposed_threshold_free_facts": {
      "structure.geometry.range-traversal": {
        "window_sessions": 20,
        "formula": "abs(close_t-close_t_minus_20)/(max_close_t_minus_20_through_t-min_close_t_minus_20_through_t)",
        "bounds": ["0", "1"],
        "zero_close_range_value": "0",
        "meaning": "how much of the observed close range is traversed from the window start to the window end; high values support one-way relocation but do not by themselves prove coherent direction"
      },
      "structure.geometry.counter-direction-excursion-share": {
        "window_sessions": 20,
        "up_net_formula": "max(running_max_close_to_s-close_s)/(max_close-min_close)",
        "down_net_formula": "max(close_s-running_min_close_to_s)/(max_close-min_close)",
        "bounds": ["0", "1"],
        "zero_net_displacement": "unavailable:zero_net_direction",
        "meaning": "largest excursion against the endpoint direction as a share of the observed close range; low values support coherent relocation and high values expose substantial path reversal"
      }
    },
    "not_promoted_in_v1": {
      "daily_sign_reversal_rate": "Stage-007 diagnostic showed little separation between true Stage 0 and the directional false positives",
      "daily_direction_agreement_share": "incremental value was limited and it is partially redundant with directional efficiency",
      "linear_trend_r_squared": "diagnostically useful but less interpretable and more model-like than the minimum required path geometry"
    },
    "stage_thresholds_in_fact_identity": false,
    "facts_emit_stage_labels": false
  },
  "projection_design": {
