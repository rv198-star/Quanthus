  "scope": {
    "target": "quantitative projection from continuous Structure Facts into the already-approved P3-STAGE-009 positive-instability channels",
    "qualitative_stage_0_semantics_changed": false,
    "stage_2_changed": false,
    "relocation_guard_retuned": false,
    "center_shift_truth_authority": false,
    "new_source_fact_required": false
  },
  "consumed_evidence_boundary": {
