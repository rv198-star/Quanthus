  "target": {
    "proposition": "structural_instability_20",
    "meaning": "positive direction-neutral structural disorder at the 20-session primary scale",
    "residual_bucket_forbidden": true,
    "center_shift_independent_positive_authority": false,
    "stage_2_changes_authorized": false,
    "relocation_guard_retuning_authorized": false
  },
  "positive_evidence_model": {
    "composition": "small_explainable_or_of_positive_channels",
    "channels": {
      "expanding_disorder_20": {
        "meaning": "the current primary-scale structure is materially expanding while the path itself lacks coherent one-way directional organization",
        "required_fact_roles": [
          "structure.geometry.width-change@20_vs_prior20",
          "structure.geometry.directional-efficiency@20",
          "structure.geometry.range-width@20"
        ],
        "center_shift_role": "modifier_only",
        "single_fact_assertion_forbidden": true
      },
      "broad_reversal_disorder_20": {
        "meaning": "the current primary-scale structure is materially broad and contains substantial path reversal or round-trip behavior even without fresh range expansion",
        "required_fact_roles": [
          "structure.geometry.range-width@20",
          "structure.geometry.directional-efficiency@20",
          "structure.geometry.range-traversal@20",
          "structure.geometry.counter-direction-excursion-share@20"
        ],
        "zero_net_handling": "counter-direction excursion may be unavailable; low traversal plus low directional efficiency can still corroborate broad round-trip disorder",
        "center_shift_role": "modifier_only",
        "single_fact_assertion_forbidden": true
      }
    },
    "resolution": {
      "TRUE": "at_least_one_positive_channel_true",
      "FALSE": "all_positive_channels_false",
      "UNKNOWN": "no_positive_channel_true_and_at_least_one_channel_unknown"
    },
    "forbidden_forms": [
      "center_shift_alone",
      "width_change_alone",
      "range_width_alone",
      "directional_efficiency_alone",
      "opaque_weighted_composite",
      "top_1_force",
      "residual_stage_0"
    ]
  },
  "center_shift_policy": {
    "fact": "structure.geometry.range-center-shift@20_vs_prior20",
    "truth_function_role": "none",
    "allowed_roles": ["description", "modifier", "reason_metadata", "relocation_context"],
    "may_change_structural_instability_truth": false,
    "strong_contraction_plus_large_center_shift_default": "not_stage_0_without_independent_positive_disorder_evidence"
  },
  "interaction_with_relocation_and_order": {
    "stage_0_requires": {
      "structural_instability_20": "TRUE",
      "coherent_directional_relocation_20": "FALSE",
      "orderly_consolidation_20": "FALSE"
    },
    "instability_true_and_relocation_true": "outside_stage_0_keep_mixed_directional_instability_reason",
    "instability_true_and_order_true": "AMBIGUOUS_CONFLICT",
    "relocation_true_and_order_false": "NEITHER",
    "no_positive_instability_and_no_order_and_no_relocation": "NEITHER_or_UNKNOWN_only_from_explicit_unknown_inputs"
  },
  "fact_scope": {
    "new_threshold_free_fact_required": false,
