#!/usr/bin/env python3
"""Audit exact DWD manifest, input-plan, ODS, model, and code authority."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_lineage_authority_audit import (  # noqa: E402
    DwdLineageAuthorityAuditError,
    audit_dwd_lineage_authority,
    write_lineage_authority_report,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dwd-root", type=Path, required=True)
    parser.add_argument("--ods-root", type=Path, required=True)
    parser.add_argument("--plan-root", type=Path, required=True)
    parser.add_argument("--repository", type=Path, default=Path("."))
    parser.add_argument(
        "--model",
        type=Path,
        default=Path("config/pipelines/dwd-domain-model.v1.json"),
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = audit_dwd_lineage_authority(
            dwd_root=args.dwd_root,
            ods_root=args.ods_root,
            plan_root=args.plan_root,
            repository=args.repository,
            model_path=args.model,
        )
        write_lineage_authority_report(
            args.output, report, sealed_roots=(args.dwd_root, args.ods_root)
        )
    except (DwdLineageAuthorityAuditError, OSError) as exc:
        print(f"DWD lineage authority audit failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "status": report["status"],
                "canonical_digest": report["canonical_digest"],
                "output": str(args.output.resolve()),
            },
            sort_keys=True,
        )
    )
    return 0 if report["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
