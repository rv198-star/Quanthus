#!/usr/bin/env python3
"""Deeply audit sealed DWD Base mirrors and all 33 historical knowledge semantics."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_pit_audit import (  # noqa: E402
    DwdPitAuditError,
    audit_and_write_dwd_pit_semantics,
)


def _mirror(value: str) -> tuple[str, Path]:
    label, separator, raw_path = value.partition("=")
    if not separator or not label.strip() or not raw_path.strip():
        raise argparse.ArgumentTypeError("mirror must use LABEL=/absolute/path")
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("mirror path must be absolute")
    return label.strip(), path


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Verify sealed DWD Base mirrors and scan every table's "
            "knowledge/reference distribution."
        )
    )
    parser.add_argument(
        "--mirror",
        action="append",
        type=_mirror,
        required=True,
        metavar="LABEL=/ABSOLUTE/PATH",
        help="repeat for Hermes, CN01, and OCI installed Base roots",
    )
    parser.add_argument(
        "--policy",
        type=Path,
        default=Path("config/audits/dwd-pit-semantics.v1.json"),
    )
    parser.add_argument(
        "--model",
        type=Path,
        default=Path("config/pipelines/dwd-domain-model.v1.json"),
    )
    parser.add_argument("--mode", choices=("full", "manifest-only"), default="full")
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--markdown-output", type=Path)
    args = parser.parse_args()
    mirrors: dict[str, Path] = {}
    for label, path in args.mirror:
        if label in mirrors:
            parser.error(f"duplicate mirror label: {label}")
        mirrors[label] = path
    try:
        report = audit_and_write_dwd_pit_semantics(
            mirrors=mirrors,
            policy_path=args.policy,
            model_path=args.model,
            mode=args.mode,
            output=args.output,
            markdown_output=args.markdown_output,
        )
    except (DwdPitAuditError, OSError) as exc:
        print(f"DWD PIT audit failed: {exc}", file=sys.stderr)
        return 2
    execution = report["execution_gate"]
    print(
        json.dumps(
            {
                "execution_gate": execution["status"],
                "historical_pit_gate": report["historical_pit_gate"]["status"],
                "output": str(args.output.resolve()),
                "report_digest": report["report_digest"],
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0 if execution["status"] == "complete" else 2


if __name__ == "__main__":
    raise SystemExit(main())
