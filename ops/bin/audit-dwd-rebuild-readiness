#!/usr/bin/env python3
"""Audit CN01 NFS, capacity, pilot, pointer, and rollback readiness."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_rebuild_readiness_audit import (  # noqa: E402
    DwdRebuildReadinessAuditError,
    audit_dwd_rebuild_readiness,
    write_readiness_report,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, default=Path("."))
    parser.add_argument("--base-root", type=Path, required=True)
    parser.add_argument("--plan-root", type=Path, required=True)
    parser.add_argument("--workspace-root", type=Path, required=True)
    parser.add_argument("--coordination-root", type=Path, required=True)
    parser.add_argument("--lock-path", type=Path, required=True)
    parser.add_argument("--current-pointer", type=Path, required=True)
    parser.add_argument("--ingress-path", type=Path, required=True)
    parser.add_argument("--installed-successor", type=Path, required=True)
    parser.add_argument("--closure-root", type=Path)
    parser.add_argument("--pilot-report", type=Path)
    parser.add_argument("--policy", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = audit_dwd_rebuild_readiness(
            repository=args.repository,
            base_root=args.base_root,
            plan_root=args.plan_root,
            workspace_root=args.workspace_root,
            coordination_root=args.coordination_root,
            lock_path=args.lock_path,
            current_pointer=args.current_pointer,
            ingress_path=args.ingress_path,
            installed_successor=args.installed_successor,
            closure_root=args.closure_root,
            pilot_report=args.pilot_report,
            policy_path=args.policy,
        )
        write_readiness_report(
            args.output,
            report,
            sealed_roots=(args.base_root, args.plan_root),
        )
    except (DwdRebuildReadinessAuditError, OSError) as exc:
        print(f"DWD rebuild readiness audit failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(report["summary"], ensure_ascii=True, sort_keys=True))
    return 0 if report["summary"]["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
