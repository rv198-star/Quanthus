#!/usr/bin/env python3
"""Check for two independent, digest-bound DWD Base replay executions."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_replay_determinism_audit import (  # noqa: E402
    DwdReplayDeterminismAuditError,
    audit_dwd_replay_determinism,
    write_replay_determinism_report,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-root", type=Path, required=True)
    parser.add_argument("--plan-root", type=Path, required=True)
    parser.add_argument("--replay-a", type=Path)
    parser.add_argument("--replay-b", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = audit_dwd_replay_determinism(
            base_root=args.base_root,
            plan_root=args.plan_root,
            replay_a=args.replay_a,
            replay_b=args.replay_b,
        )
        write_replay_determinism_report(args.output, report, sealed_roots=(args.base_root, args.plan_root))
    except (DwdReplayDeterminismAuditError, OSError) as exc:
        print(f"DWD replay determinism audit failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(report["summary"], ensure_ascii=True, sort_keys=True))
    return 0 if report["summary"]["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
