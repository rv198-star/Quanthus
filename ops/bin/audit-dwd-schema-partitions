#!/usr/bin/env python3
"""Audit every DWD Base V2 Parquet schema and partition without mutation."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_pre_rebuild_audit import (  # noqa: E402
    DwdPreRebuildAuditError,
    audit_dwd_schema_and_partitions,
    write_phase_b_report,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument(
        "--model",
        type=Path,
        default=Path("config/pipelines/dwd-domain-model.v1.json"),
    )
    parser.add_argument(
        "--model-extension",
        type=Path,
        default=Path("config/pipelines/dwd-domain-model.v1.1-extension.json"),
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = audit_dwd_schema_and_partitions(
            root=args.root,
            model_path=args.model,
            extension_path=args.model_extension,
        )
        write_phase_b_report(args.output, report, sealed_roots=(args.root,))
    except (DwdPreRebuildAuditError, OSError) as exc:
        print(f"DWD Phase B audit failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "status": report["summary"]["status"],
                "canonical_digest": report["canonical_digest"],
                "semantic_digest": report["semantic_digest"],
                "output": str(args.output.resolve()),
            },
            sort_keys=True,
        )
    )
    return 0 if report["summary"]["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
