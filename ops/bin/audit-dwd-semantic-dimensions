#!/usr/bin/env python3
"""Project sealed CN01 semantic/PIT evidence into the five named audit outputs."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_semantic_dimension_audit import (  # noqa: E402
    DwdSemanticDimensionAuditError,
    audit_dwd_semantic_dimensions,
    write_semantic_dimension_reports,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--semantic-report", type=Path, required=True)
    parser.add_argument("--pit-report", type=Path, required=True)
    parser.add_argument("--output-root", type=Path, required=True)
    args = parser.parse_args()
    try:
        report = audit_dwd_semantic_dimensions(
            semantic_report_path=args.semantic_report,
            pit_report_path=args.pit_report,
        )
        result = write_semantic_dimension_reports(
            args.output_root,
            report,
            sealed_roots=(args.semantic_report, args.pit_report),
        )
    except (DwdSemanticDimensionAuditError, OSError) as exc:
        print(f"DWD semantic dimension audit failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result["summary"], ensure_ascii=True, sort_keys=True))
    return 0 if result["summary"]["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
