#!/usr/bin/env python3
"""Audit exact ODS Base mirrors and source-family PIT sufficiency read-only."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_pit_audit import (  # noqa: E402
    OdsPitAuditError,
    _validate_output_paths,
    audit_ods_pit_sufficiency,
    write_ods_pit_audit_report,
)


def _mirror(value: str) -> tuple[str, Path]:
    label, separator, raw_path = value.partition("=")
    if not separator or not label.strip() or not raw_path.strip():
        raise argparse.ArgumentTypeError("mirror must be LABEL=/absolute/path")
    path = Path(raw_path)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("mirror path must be absolute")
    return label.strip(), path


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Deep-verify Hermes/CN01 ODS Base mirrors and scan required source fields "
            "without modifying the packages."
        )
    )
    parser.add_argument("--mirror", action="append", type=_mirror, required=True)
    parser.add_argument(
        "--policy",
        type=Path,
        default=Path("config/audits/ods-pit-sufficiency.v1.json"),
    )
    parser.add_argument("--mode", choices=("full", "manifest-only"), default="full")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    mirrors: dict[str, Path] = {}
    for label, path in args.mirror:
        if label in mirrors:
            parser.error(f"duplicate mirror label: {label}")
        mirrors[label] = path
    try:
        _validate_output_paths([args.output], mirrors=mirrors)
        report = audit_ods_pit_sufficiency(
            mirrors=mirrors,
            policy_path=args.policy,
            mode=args.mode,
        )
        write_ods_pit_audit_report(args.output, report)
    except (OdsPitAuditError, OSError) as exc:
        print(f"ODS PIT sufficiency audit failed: {exc}", file=sys.stderr)
        return 2

    print(
        json.dumps(
            {
                "execution_gate": report["execution_gate"]["status"],
                "remediation_gate": report["remediation_gate"]["status"],
                "output": str(args.output),
                "report_digest": report["report_digest"],
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0 if report["execution_gate"]["status"] == "passed" else 2


if __name__ == "__main__":
    raise SystemExit(main())
