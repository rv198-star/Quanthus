#!/usr/bin/env python3
"""Build and optionally promote one CN01 Base-seeded daily DWD increment."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse import (  # noqa: E402
    DailyDomainBuildError,
    advance_daily_current,
    build_daily_domain_increment,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--catalog", type=Path, required=True)
    parser.add_argument("--release-root", type=Path, required=True)
    parser.add_argument("--base", type=Path, required=True)
    parser.add_argument("--release-config", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--code-revision", required=True)
    parser.add_argument("--current", type=Path)
    parser.add_argument("--promote", action="store_true")
    args = parser.parse_args()
    try:
        result = build_daily_domain_increment(
            catalog_root=args.catalog,
            release_root=args.release_root,
            base_root=args.base,
            release_config=args.release_config,
            output=args.output,
            code_revision=args.code_revision,
            prior_pointer=args.current,
        )
        if args.promote:
            if args.current is None:
                raise DailyDomainBuildError("--promote requires --current")
            advance_daily_current(package=result.root, pointer=args.current)
    except (DailyDomainBuildError, OSError, ValueError) as exc:
        print(f"CN01 daily DWD build failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.__dict__, default=str, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
