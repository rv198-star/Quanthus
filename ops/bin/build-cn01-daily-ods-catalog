#!/usr/bin/env python3
"""Seal the four CN01 ODS releases used by one daily DWD build."""

from __future__ import annotations

import argparse
import json
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse import (  # noqa: E402
    DailyOdsCatalogError,
    build_daily_ods_catalog,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--release-root", type=Path, required=True)
    parser.add_argument("--market-date", type=date.fromisoformat, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = build_daily_ods_catalog(
            release_root=args.release_root, market_date=args.market_date, output=args.output
        )
    except (DailyOdsCatalogError, OSError, ValueError) as exc:
        print(f"CN01 daily ODS catalog failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.__dict__, default=str, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
