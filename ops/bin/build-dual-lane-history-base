#!/usr/bin/env python3
"""Build one immutable DWD/DWS historical base bundle."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from quanthus.pipelines.dual_lane_history import (
    DualLaneHistoryError,
    build_history_base_bundle,
    load_history_base_policy,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--bundle-id", required=True)
    parser.add_argument("--code-revision", required=True)
    args = parser.parse_args()
    try:
        result = build_history_base_bundle(
            source=args.source,
            output=args.output,
            bundle_id=args.bundle_id,
            policy=load_history_base_policy(args.policy),
            code_revision=args.code_revision,
        )
    except (DualLaneHistoryError, FileExistsError, OSError) as exc:
        print(f"historical-base build failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "bundle_id": result.bundle_id,
                "content_digest": result.content_digest,
                "dwd_date_start": result.dwd_date_start.isoformat(),
                "dwd_date_end": result.dwd_date_end.isoformat(),
                "dws_date_start": result.dws_date_start.isoformat(),
                "dws_date_end": result.dws_date_end.isoformat(),
                "dws_row_count": result.dws_row_count,
                "manifest_sha256": result.manifest_sha256,
                "output": str(result.root),
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
