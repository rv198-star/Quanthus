#!/usr/bin/env python3
"""Build one lane-local logical catalog over a base and daily candidates."""

from __future__ import annotations

import argparse
import grp
import json
import os
import pwd
import sys
from pathlib import Path

from quanthus.pipelines.dual_lane_history import (
    DualLaneHistoryError,
    build_lane_history_catalog,
    load_history_base_policy,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--storage-root", type=Path, required=True)
    parser.add_argument("--base-current", type=Path, required=True)
    parser.add_argument("--candidate-root", type=Path, required=True)
    parser.add_argument("--catalog-root", type=Path, required=True)
    parser.add_argument("--lane-id", choices=("cn01", "hermes"), required=True)
    parser.add_argument("--owner")
    parser.add_argument("--group")
    args = parser.parse_args()
    if (args.owner is None) != (args.group is None):
        parser.error("--owner and --group must be provided together")
    if args.owner is not None and os.geteuid() != 0:
        parser.error("ownership changes require root")
    owner_uid = None if args.owner is None else pwd.getpwnam(args.owner).pw_uid
    group_gid = None if args.group is None else grp.getgrnam(args.group).gr_gid
    try:
        result = build_lane_history_catalog(
            storage_root=args.storage_root,
            base_current=args.base_current,
            candidate_root=args.candidate_root,
            catalog_root=args.catalog_root,
            lane_id=args.lane_id,
            policy=load_history_base_policy(args.policy),
            owner_uid=owner_uid,
            group_gid=group_gid,
        )
    except (DualLaneHistoryError, FileExistsError, OSError) as exc:
        print(f"lane-history catalog build failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "base_bundle_id": result.base.bundle_id,
                "candidate_count": len(result.candidates),
                "catalog_id": result.catalog_id,
                "content_digest": result.content_digest,
                "lane_id": result.lane_id,
                "manifest_sha256": result.manifest_sha256,
                "through_date": result.through_date.isoformat(),
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
