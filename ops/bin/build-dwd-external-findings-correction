#!/usr/bin/env python3
"""Build the immutable correction for DWD v2.1 external findings."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse.dwd_correction import (  # noqa: E402
    DwdCorrectionError,
    build_dwd_correction,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--parent", type=Path, required=True)
    parser.add_argument("--normalization-revision", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--correction-id", required=True)
    parser.add_argument("--built-at", required=True)
    parser.add_argument("--code-revision", required=True)
    args = parser.parse_args()
    try:
        result = build_dwd_correction(
            parent=args.parent,
            normalization_revision=args.normalization_revision,
            output=args.output,
            correction_id=args.correction_id,
            built_at=args.built_at,
            code_revision=args.code_revision,
        )
    except (DwdCorrectionError, FileExistsError, OSError) as exc:
        print(f"DWD correction build failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.to_dict(), ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
