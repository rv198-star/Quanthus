#!/usr/bin/env python3
"""Audit inputs or build the three-object financial-reporting DWD candidate."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse.financial_reporting import (  # noqa: E402
    FinancialReportingBuildError,
    audit_financial_native_source_package,
    build_financial_reporting,
    combine_financial_reporting_source_audits,
)


def _common_inputs(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--ods-package", type=Path, required=True)
    parser.add_argument("--input-plan", type=Path, required=True)
    parser.add_argument("--model", type=Path, required=True)
    parser.add_argument("--listed-company-candidate", type=Path, required=True)
    parser.add_argument("--run-id", required=True)


def main() -> int:
    parser = argparse.ArgumentParser()
    subcommands = parser.add_subparsers(dest="command", required=True)
    audit_parser = subcommands.add_parser("audit-native")
    _common_inputs(audit_parser)
    audit_parser.add_argument("--output", type=Path, required=True)
    audit_parser.add_argument("--batch-size", type=int, default=4096)
    combine_parser = subcommands.add_parser("combine-audits")
    combine_parser.add_argument("--statement-audit", type=Path, required=True)
    combine_parser.add_argument("--native-audit", type=Path, required=True)
    combine_parser.add_argument("--output", type=Path, required=True)
    build_parser = subcommands.add_parser("build")
    _common_inputs(build_parser)
    build_parser.add_argument("--source-audit", type=Path, required=True)
    build_parser.add_argument("--output", type=Path, required=True)
    build_parser.add_argument("--source-batch-size", type=int, default=32)
    args = parser.parse_args()
    try:
        if args.command == "combine-audits":
            audit = combine_financial_reporting_source_audits(
                statement_audit_path=args.statement_audit,
                native_audit_path=args.native_audit,
                output=args.output,
            )
            print(
                json.dumps(
                    {
                        "output": str(args.output.resolve()),
                        "candidate_size_calibration": audit.report[
                            "candidate_size_calibration"
                        ],
                    },
                    ensure_ascii=True,
                    sort_keys=True,
                )
            )
            return 0
        if args.command == "audit-native":
            audit = audit_financial_native_source_package(
                ods_package=args.ods_package,
                input_plan=args.input_plan,
                model_path=args.model,
                listed_company_candidate=args.listed_company_candidate,
                output=args.output,
                run_id=args.run_id,
                batch_size=args.batch_size,
            )
            print(
                json.dumps(
                    {
                        "output": str(args.output.resolve()),
                        "candidate_size_calibration": audit.report[
                            "candidate_size_calibration"
                        ],
                        "quality_exceptions": audit.report["quality_exceptions"],
                    },
                    ensure_ascii=True,
                    sort_keys=True,
                )
            )
            return 0
        result = build_financial_reporting(
            ods_package=args.ods_package,
            input_plan=args.input_plan,
            model_path=args.model,
            listed_company_candidate=args.listed_company_candidate,
            source_audit_path=args.source_audit,
            output=args.output,
            run_id=args.run_id,
            source_batch_size=args.source_batch_size,
        )
    except (FinancialReportingBuildError, OSError) as exc:
        print(f"financial-reporting DWD build failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "output": str(result.root),
                "row_counts": result.row_counts,
                "semantic_digest": result.semantic_digest,
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
