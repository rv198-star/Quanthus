#!/usr/bin/env python3
"""Audit or build the four-object Issue #63 DWD candidate."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse.ownership_capital import (  # noqa: E402
    OwnershipCapitalBuildError,
    audit_ownership_capital_source_package,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    subcommands = parser.add_subparsers(dest="command", required=True)
    audit = subcommands.add_parser("audit-sources")
    audit.add_argument("--ods-package", type=Path, required=True)
    audit.add_argument("--input-plan", type=Path, required=True)
    audit.add_argument("--model", type=Path, required=True)
    audit.add_argument("--model-extension", type=Path, required=True)
    audit.add_argument("--listed-company-candidate", type=Path, required=True)
    audit.add_argument("--output", type=Path, required=True)
    audit.add_argument("--run-id", required=True)
    args = parser.parse_args()
    try:
        result = audit_ownership_capital_source_package(
            ods_package=args.ods_package,
            input_plan=args.input_plan,
            model_path=args.model,
            model_extension_path=args.model_extension,
            listed_company_candidate=args.listed_company_candidate,
            output=args.output,
            run_id=args.run_id,
        )
    except (OwnershipCapitalBuildError, OSError) as exc:
        print(f"ownership-capital DWD failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "output": str(args.output.resolve()),
                "source_rows": result.report["source_rows"],
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
