#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
IMAGE_TAG=${1:-quanthus-event:local}
CODE_REVISION=$(git -C "$REPOSITORY_ROOT" rev-parse HEAD)
if [[ ! "$CODE_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
    echo "event image build requires an exact git revision" >&2
    exit 2
fi
if [[ -n "$(git -C "$REPOSITORY_ROOT" status --porcelain)" ]]; then
    echo "event image build requires a clean git checkout" >&2
    exit 2
fi
BUILD_CONTEXT=$(mktemp -d /tmp/quanthus-event-image.XXXXXX)

cleanup() {
    rm -rf -- "$BUILD_CONTEXT"
}
trap cleanup EXIT INT TERM

install -d "$BUILD_CONTEXT/config" "$BUILD_CONTEXT/src/quanthus" \
    "$BUILD_CONTEXT/docs/acceptance" "$BUILD_CONTEXT/docs/reviews"
cp "$REPOSITORY_ROOT/pyproject.toml" "$REPOSITORY_ROOT/README.md" "$BUILD_CONTEXT/"
for relative in \
    docs/acceptance/structure-intelligence-economic-final-acceptance-20260906.md \
    docs/reviews/stage-p032-level1-evidence-four-party-review-20260916.md \
    docs/reviews/stage-p033-value-route-review-20260916.md \
    docs/reviews/p3-expert-stage-consumption-direction-review-20260917.md \
    docs/design/lld/04-experts-aggregator/expert-strategy-layer.md; do
    install -D -m 0644 "$REPOSITORY_ROOT/$relative" "$BUILD_CONTEXT/$relative"
done

while IFS= read -r source; do
    relative=${source#"$REPOSITORY_ROOT/"}
    install -D -m 0644 "$source" "$BUILD_CONTEXT/$relative"
done < <(
    find "$REPOSITORY_ROOT/config" -type f -readable -print
    find "$REPOSITORY_ROOT/src/quanthus" -type f -readable -name '*.py' -print
)

cp "$REPOSITORY_ROOT/ops/event/Dockerfile" "$BUILD_CONTEXT/Dockerfile"
docker build \
    --build-arg "QUANTHUS_CODE_REVISION=$CODE_REVISION" \
    --tag "$IMAGE_TAG" \
    "$BUILD_CONTEXT"

printf 'Event image built: %s\n' "$IMAGE_TAG"
