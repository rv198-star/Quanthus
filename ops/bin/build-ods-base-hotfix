#!/usr/bin/env python3
"""Build an immutable ODS Base Hotfix from a completed provider workspace."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base_hotfix import (
    OdsBaseHotfixError,
    build_hotfix_bundle,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--parent-base", type=Path, required=True)
    parser.add_argument("--workspace", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--hotfix-id", required=True)
    parser.add_argument("--code-revision", required=True)
    args = parser.parse_args()
    try:
        result = build_hotfix_bundle(
            parent_base=args.parent_base,
            workspace=args.workspace,
            output=args.output,
            hotfix_id=args.hotfix_id,
            code_revision=args.code_revision,
        )
    except (OdsBaseHotfixError, FileExistsError, OSError) as exc:
        print(f"ODS Base Hotfix build failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.to_dict(), ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
