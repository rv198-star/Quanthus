#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
IMAGE_TAG=${1:-quanthus-platform-kernel:local}
BUILD_CONTEXT=$(mktemp -d /tmp/quanthus-platform-image.XXXXXX)

cleanup() {
    rm -rf -- "$BUILD_CONTEXT"
}
trap cleanup EXIT INT TERM

install -d \
    "$BUILD_CONTEXT/config/expert-evaluations/experts" \
    "$BUILD_CONTEXT/config/expert-evaluations/lifecycle" \
    "$BUILD_CONTEXT/config/expert-evaluations/specs" \
    "$BUILD_CONTEXT/config/expert-strategies" \
    "$BUILD_CONTEXT/config/forward-validation" \
    "$BUILD_CONTEXT/config/pipelines" \
    "$BUILD_CONTEXT/config/releases" \
    "$BUILD_CONTEXT/src/quanthus/expert_evaluation" \
    "$BUILD_CONTEXT/src/quanthus/forward_validation"
cp "$REPOSITORY_ROOT/.dockerignore" \
    "$REPOSITORY_ROOT/pyproject.toml" \
    "$REPOSITORY_ROOT/README.md" \
    "$BUILD_CONTEXT/"
cp "$REPOSITORY_ROOT/config/platform-features.v1.json" \
    "$REPOSITORY_ROOT/config/platform-kernel-gates.v1.json" \
    "$REPOSITORY_ROOT/config/product-research-catalog.v1.json" \
    "$REPOSITORY_ROOT/config/product-candidate-evidence.v1.json" \
    "$REPOSITORY_ROOT/config/product-expert-evidence.v1.json" \
    "$REPOSITORY_ROOT/config/data-indicator-catalog-annotations.v1.json" \
    "$REPOSITORY_ROOT/config/catalog-business-metadata.v1.json" \
    "$REPOSITORY_ROOT/config/catalog-lineage.v1.json" \
    "$REPOSITORY_ROOT/config/catalog-adm-assets.v1.json" \
    "$REPOSITORY_ROOT/config/catalog-asset-lineage.v2.json" \
    "$REPOSITORY_ROOT/config/p4-research-adm.v1.json" \
    "$REPOSITORY_ROOT/config/structure-research-adm.mvp.v1.json" \
    "$REPOSITORY_ROOT/config/structure-continuous-facts.research.v1.json" \
    "$REPOSITORY_ROOT/config/data-indicator-catalog-snapshot.v1.json" \
    "$REPOSITORY_ROOT/config/data-indicator-catalog-sources.v1.json" \
    "$REPOSITORY_ROOT/config/p3-baseline-features.research.v1.json" \
    "$REPOSITORY_ROOT/config/p3-governed-feature-extension.research.v1.json" \
    "$REPOSITORY_ROOT/config/p3-governed-labels.research.v1.json" \
    "$REPOSITORY_ROOT/config/structure-semantic-catalog.v1.json" \
    "$REPOSITORY_ROOT/config/structure-facts-v2-blueprint.v1.json" \
    "$BUILD_CONTEXT/config/"
cp "$REPOSITORY_ROOT/config/pipelines/ods-base-final-through-20260731.v2.json" \
    "$REPOSITORY_ROOT/config/pipelines/dwd-domain-model.v1.json" \
    "$REPOSITORY_ROOT/config/pipelines/dwd-domain-model.v1.1-extension.json" \
    "$BUILD_CONTEXT/config/pipelines/"
cp -a "$REPOSITORY_ROOT/config/forward-validation/." \
    "$BUILD_CONTEXT/config/forward-validation/"
cp "$REPOSITORY_ROOT/config/releases/v2-build202607.json" \
    "$BUILD_CONTEXT/config/releases/"
cp "$REPOSITORY_ROOT/config/p4-candidate-price-volume-transition.research.v1.json" \
    "$BUILD_CONTEXT/config/"
cp "$REPOSITORY_ROOT/config/expert-strategies/p4-trend-risk.v1.0.1.json" \
    "$BUILD_CONTEXT/config/expert-strategies/"
cp "$REPOSITORY_ROOT/config/expert-evaluations/experts/trend-stability.v1.json" \
    "$BUILD_CONTEXT/config/expert-evaluations/experts/"
cp "$REPOSITORY_ROOT/config/expert-evaluations/specs/trend-stability-p4-first-passage.evaluation.v1.json" \
    "$BUILD_CONTEXT/config/expert-evaluations/specs/"
cp "$REPOSITORY_ROOT/config/expert-evaluations/lifecycle/candidate-p4-trend-risk-1.0.1.inconclusive.v1.json" \
    "$BUILD_CONTEXT/config/expert-evaluations/lifecycle/"
cp "$REPOSITORY_ROOT/src/quanthus/__init__.py" \
    "$REPOSITORY_ROOT/src/quanthus/data_catalog.py" \
    "$REPOSITORY_ROOT/src/quanthus/catalog_presentation.py" \
    "$REPOSITORY_ROOT/src/quanthus/catalog_lineage.py" \
    "$REPOSITORY_ROOT/src/quanthus/catalog_asset_lineage.py" \
    "$REPOSITORY_ROOT/src/quanthus/catalog_dependency.py" \
    "$REPOSITORY_ROOT/src/quanthus/policy.py" \
    "$REPOSITORY_ROOT/src/quanthus/strategy_attribution.py" \
    "$REPOSITORY_ROOT/src/quanthus/strategy_attribution_pipeline.py" \
    "$REPOSITORY_ROOT/src/quanthus/strategy_attribution_planning.py" \
    "$REPOSITORY_ROOT/src/quanthus/strategy_attribution_publication.py" \
    "$BUILD_CONTEXT/src/quanthus/"
cp "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/__init__.py" \
    "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/contracts.py" \
    "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/product_view.py" \
    "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/release_verification.py" \
    "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/runner.py" \
    "$REPOSITORY_ROOT/src/quanthus/expert_evaluation/serialization.py" \
    "$BUILD_CONTEXT/src/quanthus/expert_evaluation/"
cp "$REPOSITORY_ROOT/src/quanthus/forward_validation/__init__.py" \
    "$REPOSITORY_ROOT/src/quanthus/forward_validation/activation.py" \
    "$REPOSITORY_ROOT/src/quanthus/forward_validation/contracts.py" \
    "$REPOSITORY_ROOT/src/quanthus/forward_validation/serialization.py" \
    "$REPOSITORY_ROOT/src/quanthus/forward_validation/product_view.py" \
    "$BUILD_CONTEXT/src/quanthus/forward_validation/"
cp -a "$REPOSITORY_ROOT/src/quanthus/platform" "$BUILD_CONTEXT/src/quanthus/"

docker build \
    --file "$REPOSITORY_ROOT/ops/platform/Dockerfile" \
    --tag "$IMAGE_TAG" \
    "$BUILD_CONTEXT"

printf 'Platform Kernel image built: %s\n' "$IMAGE_TAG"
