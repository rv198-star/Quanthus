#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
IMAGE_TAG=${1:-quanthus-replay:local}
BUILD_CONTEXT=$(mktemp -d /tmp/quanthus-replay-image.XXXXXX)

cleanup() {
    rm -rf -- "$BUILD_CONTEXT"
}
trap cleanup EXIT INT TERM

install -d "$BUILD_CONTEXT/config" "$BUILD_CONTEXT/src/quanthus"
cp "$REPOSITORY_ROOT/pyproject.toml" "$REPOSITORY_ROOT/README.md" "$BUILD_CONTEXT/"

while IFS= read -r source; do
    relative=${source#"$REPOSITORY_ROOT/"}
    install -D -m 0644 "$source" "$BUILD_CONTEXT/$relative"
done < <(
    find "$REPOSITORY_ROOT/config" -type f -readable -print
    find "$REPOSITORY_ROOT/src/quanthus" \
        -path "$REPOSITORY_ROOT/src/quanthus/event_library" -prune -o \
        -type f -readable -name '*.py' -print
)

cp "$REPOSITORY_ROOT/ops/replay/Dockerfile" "$BUILD_CONTEXT/Dockerfile"
docker build --tag "$IMAGE_TAG" "$BUILD_CONTEXT"

printf 'Replay image built: %s\n' "$IMAGE_TAG"
