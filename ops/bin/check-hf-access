#!/usr/bin/env python3
"""Gate Hugging Face Hub access for CN02 on the machine-local proxy.

Direct HTTPS to huggingface.co fails from CN02; the enabled cn02-proxy.service
publishes local SOCKS5 exits (US.Stlaure / US.WePC) on 127.0.0.1:10800-10803.
This checker proves the proxy path before a Hub read or upload: API answer, the
observed exit country, and a byte-range read over the CDN redirect chain. It
prints one JSON object and exits non-zero when a required step fails.

Usage: check-hf-access [--proxy socks5h://127.0.0.1:10800]
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

DEFAULT_PROXY = "socks5h://127.0.0.1:10800"
API_URL = "https://huggingface.co/api/models?limit=1"
EXIT_URL = "https://ipinfo.io/json"
RANGE_URL = (
    "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/"
    "hub/duckdb_hf_url.png"
)


def curl(args: list[str], *, timeout: int = 30) -> tuple[int, str]:
    done = subprocess.run(
        ["curl", "-sS", "--max-time", str(timeout), *args],
        capture_output=True,
        text=True,
    )
    return done.returncode, (done.stdout + done.stderr).strip()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--proxy", default=os.environ.get("HF_PROXY", DEFAULT_PROXY))
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    proxy = args.proxy
    report: dict[str, object] = {"proxy": proxy}
    failures: list[str] = []

    code, body = curl(["-x", proxy, "-o", "/dev/null", "-w", "%{http_code}", API_URL])
    report["api_status"] = body[-3:] if code == 0 else None
    report["api_ok"] = code == 0 and body.endswith("200")
    if not report["api_ok"]:
        failures.append("api")

    code, body = curl(["-x", proxy, EXIT_URL])
    try:
        location = json.loads(body)
        report["exit_ip"] = location.get("ip")
        report["exit_country"] = location.get("country")
        report["exit_org"] = location.get("org")
    except json.JSONDecodeError:
        report["exit_error"] = body[:200]
        failures.append("exit-check")

    code, body = curl(
        ["-x", proxy, "-L", "-r", "0-1023", "-o", "/dev/null",
         "-w", "%{http_code} %{size_download}", RANGE_URL]
    )
    parts = body.split()
    report["range_status"] = parts[0] if parts else None
    report["range_bytes"] = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else None
    report["range_ok"] = code == 0 and report["range_status"] == "206" and report["range_bytes"] == 1024
    if not report["range_ok"]:
        failures.append("range-read")

    token = os.environ.get("HF_TOKEN") or os.environ.get("HUGGING_FACE_HUB_TOKEN")
    if token:
        code, body = curl(
            ["-x", proxy, "-H", "Authorization: Bearer " + token,
             "-o", "/dev/null", "-w", "%{http_code}", "https://huggingface.co/api/whoami-v2"]
        )
        report["token_status"] = body[-3:] if code == 0 else None
        report["token_ok"] = code == 0 and body.endswith("200")
        if not report["token_ok"]:
            failures.append("token")
    else:
        report["token_ok"] = None
        report["token_note"] = "HF_TOKEN unset; authenticated checks skipped"

    report["ok"] = not failures
    report["failures"] = failures
    print(json.dumps(report, ensure_ascii=False, indent=2 if not args.json else None))
    return 0 if not failures else 1


if __name__ == "__main__":
    sys.exit(main())

