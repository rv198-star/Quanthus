#!/usr/bin/env python3
"""Collect CN01 DWD audit reports into a provisional closure packet."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_audit_closure import (  # noqa: E402
    DwdAuditClosureError,
    build_audit_closure,
)


def _revision(repository: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=repository,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode or len(result.stdout.strip()) != 40:
        raise DwdAuditClosureError("cannot resolve exact Git revision")
    return result.stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, default=Path("."))
    parser.add_argument("--base-root", type=Path, required=True)
    parser.add_argument("--plan-root", type=Path, required=True)
    parser.add_argument("--schema-report", type=Path, required=True)
    parser.add_argument("--semantic-report", type=Path, required=True)
    parser.add_argument("--lineage-report", type=Path, required=True)
    parser.add_argument("--invariant-report", type=Path, required=True)
    parser.add_argument("--phase-a-findings", type=Path, required=True)
    parser.add_argument("--daily-root", type=Path, required=True)
    parser.add_argument("--output-root", type=Path, required=True)
    parser.add_argument("--code-revision")
    parser.add_argument("--replay-evidence", type=Path, action="append", default=[])
    args = parser.parse_args()
    try:
        repository = args.repository.resolve()
        result = build_audit_closure(
            base_root=args.base_root,
            plan_root=args.plan_root,
            schema_report=args.schema_report,
            semantic_report=args.semantic_report,
            lineage_report=args.lineage_report,
            invariant_report=args.invariant_report,
            phase_a_findings=args.phase_a_findings,
            daily_root=args.daily_root,
            output_root=args.output_root,
            code_revision=args.code_revision or _revision(repository),
            replay_evidence=args.replay_evidence,
        )
    except (DwdAuditClosureError, OSError) as exc:
        print(f"DWD audit closure failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
