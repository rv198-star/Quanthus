#!/usr/bin/env python3
"""One bounded research task on one pinned Hugging Face DWD Base.

The script is the Worker-facing execution package requested by the research roadmap:

    fetch    resolve the pinned Base manifest, download the declared closure, verify every byte
    screen   run one pre-declared bounded statistic over the sealed DWD tables
    publish  build a fixed result package and publish it to a Hugging Face dataset

It deliberately reads the sealed DWD directly instead of a replay engine: the existing P2 stack
cannot bind Base 2.5.1 without a new corporate-action normalization chain, and that adapter is a
separate bounded repair. Nothing here grants strategy, PIT or production authority.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import resource
import shutil
import sys
import time
import urllib.parse
import urllib.request
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Any

EXPECTED_SCHEMA = "quanthus.hf-dwd-research-request.v1"
RESULT_SCHEMA = "quanthus.hf-dwd-research-result.v1"
HF_ENDPOINT = "https://huggingface.co"


def canonical_digest(value: Any) -> str:
    encoded = json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def open_url(url: str, token: str, timeout: int = 120) -> urllib.request.addinfourl:
    request = urllib.request.Request(url)
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    proxies = {}
    for scheme in ("http", "https"):
        value = os.environ.get(f"{scheme.upper()}_PROXY") or os.environ.get(f"{scheme}_proxy")
        if value:
            proxies[scheme] = value
    opener = urllib.request.build_opener(urllib.request.ProxyHandler(proxies))
    return opener.open(request, timeout=timeout)


def resolve_url(dataset: str, revision: str, path: str) -> str:
    quoted = urllib.parse.quote(path)
    return f"{HF_ENDPOINT}/datasets/{dataset}/resolve/{revision}/{quoted}"


def download(dataset: str, revision: str, path: str, destination: Path, token: str) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(destination.suffix + ".partial")
    with open_url(resolve_url(dataset, revision, path), token) as response:
        with temporary.open("wb") as handle:
            shutil.copyfileobj(response, handle, length=1024 * 1024)
    temporary.replace(destination)


def select_members(manifest: dict[str, Any], prefixes: list[str]) -> list[dict[str, Any]]:
    members = []
    for entry in manifest.get("content", {}).get("files", []):
        path = str(entry.get("path") or "")
        if any(path.startswith(prefix) for prefix in prefixes):
            members.append(
                {
                    "path": path,
                    "sha256": entry.get("sha256"),
                    "size_bytes": int(entry.get("size_bytes") or 0),
                }
            )
    return sorted(members, key=lambda item: item["path"])


def load_request(path: Path) -> dict[str, Any]:
    request = read_json(path)
    if request.get("schema_version") != EXPECTED_SCHEMA:
        raise SystemExit(f"request schema differs: {request.get('schema_version')}")
    return request


def command_fetch(args: argparse.Namespace) -> int:
    request = load_request(args.request)
    authority = request["authority"]
    job = Path(args.work).resolve()
    source = job / "source"
    source.mkdir(parents=True, exist_ok=True)
    token = os.environ.get("HF_TOKEN", "")
    started = time.time()
    manifest_path = source / "DWD/manifest.json"
    download(authority["dataset"], authority["revision"], "DWD/manifest.json", manifest_path, token)
    observed_manifest = file_sha256(manifest_path)
    if observed_manifest != authority["manifest_sha256"]:
        raise SystemExit(f"source manifest hash differs: {observed_manifest}")
    ready = source / "DWD/READY"
    download(authority["dataset"], authority["revision"], "DWD/READY", ready, token)
    if ready.read_text(encoding="ascii").strip() != observed_manifest:
        raise SystemExit("source READY marker does not bind the source manifest")
    manifest = read_json(manifest_path)
    if manifest.get("content_digest") != authority["content_digest"]:
        raise SystemExit("source content digest differs from the frozen request")
    prefixes = list(request["closure"]["include_prefixes"])
    members = select_members(manifest, prefixes)
    if not members:
        raise SystemExit("closure selection is empty")
    total_bytes = sum(int(member["size_bytes"]) for member in members)
    budget = int(request["budget"].get("max_download_bytes") or 0)
    if budget and total_bytes > budget:
        raise SystemExit(f"closure exceeds the frozen download budget: {total_bytes} > {budget}")
    downloaded = 0
    for index, member in enumerate(members, start=1):
        remote_path = f"DWD/{member['path']}"
        target = source / remote_path
        if not target.is_file() or file_sha256(target) != member["sha256"]:
            download(authority["dataset"], authority["revision"], remote_path, target, token)
        if target.stat().st_size != member["size_bytes"]:
            raise SystemExit(f"member size differs: {member['path']}")
        if file_sha256(target) != member["sha256"]:
            raise SystemExit(f"member hash differs: {member['path']}")
        downloaded += member["size_bytes"]
        if index % 25 == 0 or index == len(members):
            print(f"[fetch] {index}/{len(members)} members verified", file=sys.stderr, flush=True)
    receipt = {
        "schema_version": "quanthus.hf-dwd-fetch-receipt.v1",
        "request_id": request["request_id"],
        "dataset": authority["dataset"],
        "revision": authority["revision"],
        "manifest_sha256": observed_manifest,
        "content_digest": manifest.get("content_digest"),
        "business_through": manifest.get("business_through"),
        "member_count": len(members),
        "member_bytes": downloaded,
        "wall_seconds": round(time.time() - started, 3),
        "fetched_at": datetime.now(timezone.utc).isoformat(),
        "members": members,
    }
    write_json(job / "fetch-receipt.json", receipt)
    print(json.dumps({k: v for k, v in receipt.items() if k != "members"}, ensure_ascii=False))
    return 0


SCREEN_SQL = """
CREATE VIEW bar AS
  SELECT * FROM read_parquet('{bar_glob}', hive_partitioning=true)
  WHERE interval_size='1d' AND price_basis='UNADJUSTED' AND knowledge_to IS NULL
    AND CAST(observation_start AS DATE) BETWEEN DATE '{read_start}' AND DATE '{execution_end}';
CREATE VIEW cal AS
  SELECT * FROM read_parquet('{calendar_glob}', hive_partitioning=true)
  WHERE is_open AND knowledge_to IS NULL
    AND CAST(trade_date AS DATE) BETWEEN DATE '{read_start}' AND DATE '{execution_end}';
CREATE VIEW state AS
  SELECT * FROM read_parquet('{state_glob}', hive_partitioning=true)
  WHERE knowledge_to IS NULL
    AND CAST(observation_start AS DATE) BETWEEN DATE '{read_start}' AND DATE '{execution_end}';
CREATE VIEW listing AS
  SELECT * FROM read_parquet('{listing_glob}') WHERE knowledge_to IS NULL;
CREATE VIEW security AS
  SELECT * FROM read_parquet('{security_glob}') WHERE knowledge_to IS NULL;

CREATE VIEW session AS
  SELECT l.listing_id, l.listing_code AS stock_code, l.venue_id, l.effective_from,
         CAST(c.trade_date AS DATE) AS trade_date, c.calendar_session_id
  FROM listing l
  JOIN security sec ON sec.security_id = l.security_id
  JOIN cal c ON c.venue_id = l.venue_id
  WHERE l.venue_id IN ('{sse}', '{szse}')
    AND sec.instrument_type IN ('common_equity', 'equity')
    AND CAST(c.trade_date AS DATE) >= CAST(l.effective_from AS DATE)
    AND (l.effective_to IS NULL OR CAST(c.trade_date AS DATE) <= CAST(l.effective_to AS DATE));

CREATE VIEW joined AS
  SELECT s.stock_code, s.venue_id, s.trade_date, s.listing_id, s.calendar_session_id,
         b.open, b.close, b.turnover, b.volume,
         st.is_tradable, st.can_buy, st.can_sell,
         st.upper_price, st.lower_price,
         row_number() OVER (PARTITION BY s.listing_id ORDER BY s.trade_date) AS listing_sessions,
         count(b.close) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date
           ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS window20,
         avg(CAST(b.turnover AS DOUBLE)) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date
           ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS avg_amount_20,
         stddev_samp(CAST(b.close AS DOUBLE)) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date
           ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS vol20,
         avg(CAST(b.close AS DOUBLE)) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date
           ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS mean_close_20,
         lag(CAST(b.close AS DOUBLE)) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date) AS prior_close,
         lag(CAST(b.close AS DOUBLE), 20) OVER (
           PARTITION BY s.listing_id ORDER BY s.trade_date) AS close_20_back
  FROM session s
  LEFT JOIN bar b
    ON b.listing_id = s.listing_id AND b.calendar_session_id = s.calendar_session_id
  LEFT JOIN state st
    ON st.listing_id = s.listing_id AND st.calendar_session_id = s.calendar_session_id;

CREATE VIEW metrics AS
  SELECT *,
         CASE WHEN close_20_back > 0 THEN CAST(close AS DOUBLE) / close_20_back - 1 END AS momentum20,
         CASE WHEN prior_close > 0 THEN CAST(close AS DOUBLE) / prior_close - 1 END AS entry_day_return,
         CASE WHEN window20 = 20 AND mean_close_20 > 0
              THEN (vol20 / mean_close_20) * sqrt(252) END AS realized_vol20_annual,
         CASE WHEN venue_id = 'venue_8c0bd9088a0dc88f28e5e7fa8efdce87' THEN 'SZSE' ELSE 'SSE' END
           AS exchange
  FROM joined;

CREATE VIEW scored AS
  SELECT *,
         CASE WHEN trade_date BETWEEN DATE '{read_start}' AND DATE '{decision_end}'
                AND close IS NOT NULL AND is_tradable THEN 1 ELSE 0 END AS in_universe,
         CASE WHEN close IS NOT NULL AND is_tradable THEN 1 ELSE 0 END AS has_liquidity,
         CASE WHEN window20 = 20 AND listing_sessions >= {min_listing_sessions}
                AND avg_amount_20 IS NOT NULL AND avg_amount_20 >= {min_avg_amount}
                AND realized_vol20_annual IS NOT NULL
                AND realized_vol20_annual <= {max_vol}
                AND entry_day_return IS NOT NULL AND abs(entry_day_return) <= {max_entry_return}
                AND momentum20 IS NOT NULL AND momentum20 >= {momentum_low}
                AND momentum20 <= {momentum_high}
              THEN 1 ELSE 0 END AS is_nominal
  FROM metrics;

CREATE VIEW labelled AS
  SELECT scored.*,
         lead(CASE
                WHEN close IS NOT NULL AND is_tradable AND can_buy
                  AND NOT (open IS NOT NULL AND upper_price IS NOT NULL
                           AND CAST(open AS DOUBLE) >= CAST(upper_price AS DOUBLE) - 0.005)
                THEN 1 ELSE 0 END) OVER (
           PARTITION BY listing_id ORDER BY trade_date) AS executable_next_open,
         lead(CASE WHEN close IS NULL THEN 1 ELSE 0 END) OVER (
           PARTITION BY listing_id ORDER BY trade_date) AS next_missing_bar,
         lead(CASE WHEN is_tradable IS NOT TRUE THEN 1 ELSE 0 END) OVER (
           PARTITION BY listing_id ORDER BY trade_date) AS next_suspended,
         lead(CASE WHEN is_tradable IS TRUE AND can_buy IS NOT TRUE THEN 1 ELSE 0 END) OVER (
           PARTITION BY listing_id ORDER BY trade_date) AS next_cannot_buy,
         lead(CASE WHEN upper_price IS NOT NULL AND open IS NOT NULL
                     AND CAST(open AS DOUBLE) >= CAST(upper_price AS DOUBLE) - 0.005
                   THEN 1 ELSE 0 END) OVER (
           PARTITION BY listing_id ORDER BY trade_date) AS next_limit_blocked
  FROM scored;

CREATE VIEW windowed AS
  SELECT * FROM labelled
  WHERE trade_date BETWEEN DATE '{decision_start}' AND DATE '{decision_end}';
"""


def command_screen(args: argparse.Namespace) -> int:
    import duckdb

    request = load_request(args.request)
    job = Path(args.work).resolve()
    source = job / "source"
    if not (source / "DWD/manifest.json").is_file():
        raise SystemExit("run fetch first")
    scope = request["scope"]
    screen = request["screen"]
    roots = {
        "bar_glob": str(source / "DWD/payload/dwd_security_bar/interval_size=1d/**/*.parquet"),
        "calendar_glob": str(source / "DWD/payload/dwd_trading_calendar/**/*.parquet"),
        "state_glob": str(source / "DWD/payload/dwd_tradability_state/**/*.parquet"),
        "listing_glob": str(source / "DWD/payload/dwd_listing/**/*.parquet"),
        "security_glob": str(source / "DWD/payload/dwd_security/**/*.parquet"),
        "sse": "venue_bec59e31eb6bb28111a10d7e6d2c689f",
        "szse": "venue_8c0bd9088a0dc88f28e5e7fa8efdce87",
    }
    sql = SCREEN_SQL.format(
        **roots,
        read_start=scope["read_start"],
        decision_start=scope["decision_start"],
        decision_end=scope["decision_end"],
        execution_end=scope["execution_end"],
        min_listing_sessions=int(screen["min_listing_sessions"]),
        min_avg_amount=float(screen["min_avg_amount_20"]),
        max_vol=float(screen["max_realized_vol_20"]),
        max_entry_return=float(screen["max_entry_day_return"]),
        momentum_low=float(screen["momentum_band"][0]),
        momentum_high=float(screen["momentum_band"][1]),
    )
    started = time.time()
    connection = duckdb.connect(":memory:")
    connection.execute("SET threads=4")
    connection.execute("SET memory_limit='8GB'")
    connection.execute("SET preserve_insertion_order=false")
    connection.execute(sql)
    by_year = connection.execute(
        """
        SELECT year(trade_date) AS year,
               sum(in_universe * has_liquidity) AS universe_rows,
               sum(in_universe * has_liquidity * coalesce(executable_next_open, 0))
                 AS universe_executable,
               sum(in_universe * is_nominal) AS nominal,
               sum(in_universe * is_nominal * coalesce(executable_next_open, 0)) AS nominal_executable,
               sum(in_universe * is_nominal * coalesce(next_limit_blocked, 0)) AS nominal_limit_blocked
        FROM windowed GROUP BY 1 ORDER BY 1
        """
    ).fetchall()
    by_exchange = connection.execute(
        """
        SELECT exchange,
               sum(in_universe * has_liquidity) AS universe_rows,
               sum(in_universe * has_liquidity * coalesce(executable_next_open, 0))
                 AS universe_executable,
               sum(in_universe * is_nominal) AS nominal,
               sum(in_universe * is_nominal * coalesce(executable_next_open, 0)) AS nominal_executable,
               sum(in_universe * is_nominal * coalesce(next_limit_blocked, 0)) AS nominal_limit_blocked
        FROM windowed GROUP BY 1 ORDER BY 1
        """
    ).fetchall()
    totals = connection.execute(
        """
        SELECT count(*) AS sessions,
               sum(in_universe * has_liquidity) AS universe_rows,
               sum(in_universe * has_liquidity * coalesce(executable_next_open, 0))
                 AS universe_executable,
               sum(in_universe * is_nominal) AS nominal,
               sum(in_universe * is_nominal * coalesce(executable_next_open, 0)) AS nominal_executable,
               count(DISTINCT trade_date) AS trading_days,
               sum(in_universe * is_nominal * coalesce(next_missing_bar, 0)) AS nominal_next_missing_bar,
               sum(in_universe * is_nominal * coalesce(next_suspended, 0)) AS nominal_next_suspended,
               sum(in_universe * is_nominal * coalesce(next_cannot_buy, 0)) AS nominal_next_cannot_buy,
               sum(in_universe * is_nominal * coalesce(next_limit_blocked, 0)) AS nominal_next_limit_blocked
        FROM windowed
        """
    ).fetchone()
    connection.close()
    wall = round(time.time() - started, 3)

    def block(rows: list[tuple[Any, ...]]) -> list[dict[str, Any]]:
        return [
            {
                "key": str(row[0]),
                "universe_rows": int(row[1]),
                "universe_executable": int(row[2]),
                "nominal": int(row[3]),
                "nominal_executable": int(row[4]),
                "nominal_limit_blocked": int(row[5]),
                "universe_loss_rate": (
                    round(1 - row[2] / row[1], 6) if row[1] else None
                ),
                "nominal_loss_rate": (
                    round(1 - row[4] / row[3], 6) if row[3] else None
                ),
            }
            for row in rows
        ]

    totals_block = {
        "sessions": int(totals[0]),
        "trading_days": int(totals[5]),
        "universe_rows": int(totals[1]),
        "universe_executable": int(totals[2]),
        "nominal": int(totals[3]),
        "nominal_executable": int(totals[4]),
        "nominal_blocked_reasons": {
            "next_missing_bar": int(totals[6]),
            "next_suspended": int(totals[7]),
            "next_cannot_buy": int(totals[8]),
            "next_limit_blocked": int(totals[9]),
        },
        "universe_loss_rate": round(1 - totals[2] / totals[1], 6) if totals[1] else None,
        "nominal_loss_rate": round(1 - totals[4] / totals[3], 6) if totals[3] else None,
    }
    payload = {
        "schema_version": RESULT_SCHEMA,
        "request_id": request["request_id"],
        "task_id": request["task_id"],
        "attempt_id": request["attempt_id"],
        "authority": request["authority"],
        "scope": scope,
        "screen_parameters": screen,
        "totals": totals_block,
        "by_year": block(by_year),
        "by_exchange": block(by_exchange),
        "claim_ceiling": (
            "Closed 2020-2021 development window only; retrospective record view, not historical "
            "PIT; no strategy performance, no trading authority, no arbitration or blind access."
        ),
    }
    payload["result_digest"] = canonical_digest(payload)
    write_json(job / "result.json", payload)
    receipt = {
        "schema_version": "quanthus.hf-dwd-run-receipt.v1",
        "wall_seconds": wall,
        "max_rss_kib": int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss),
        "result_digest": payload["result_digest"],
        "recorded_at": datetime.now(timezone.utc).isoformat(),
    }
    write_json(job / "run-receipt.json", receipt)
    print(json.dumps(totals_block, ensure_ascii=False))
    return 0


def command_publish(args: argparse.Namespace) -> int:
    from huggingface_hub import HfApi

    request = load_request(args.request)
    job = Path(args.work).resolve()
    publish = request["publish"]
    result = read_json(job / "result.json")
    fetch = read_json(job / "fetch-receipt.json")
    run = read_json(job / "run-receipt.json")
    prefix = str(publish["path_prefix"]).rstrip("/")
    staging = job / "package"
    if staging.exists():
        shutil.rmtree(staging)
    (staging / prefix).mkdir(parents=True)
    artifacts = {}
    for name in ("result.json", "fetch-receipt.json", "run-receipt.json", "request.json"):
        source = job / name
        if not source.is_file():
            continue
        target = staging / prefix / name
        shutil.copy2(source, target)
        artifacts[name] = {"sha256": file_sha256(target), "size_bytes": target.stat().st_size}
    manifest = {
        "schema_version": "quanthus.hf-dwd-result-package.v1",
        "request_id": request["request_id"],
        "task_id": request["task_id"],
        "attempt_id": request["attempt_id"],
        "authority": request["authority"],
        "scope": request["scope"],
        "result_digest": result["result_digest"],
        "artifacts": artifacts,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "retention": publish.get("retention", "temporary_hf_default"),
        "claim_ceiling": result["claim_ceiling"],
    }
    manifest["package_digest"] = canonical_digest(manifest)
    write_json(staging / prefix / "manifest.json", manifest)
    write_json(job / "package-manifest.json", manifest)
    api = HfApi()
    repo_id = publish["dataset"]
    api.create_repo(
        repo_id=repo_id,
        repo_type="dataset",
        private=bool(publish.get("private", True)),
        exist_ok=True,
    )
    api.upload_folder(
        repo_id=repo_id,
        repo_type="dataset",
        folder_path=str(staging),
        path_in_repo="",
        commit_message=f"{request['task_id']} {request['attempt_id']} bounded research result",
    )
    info = api.dataset_info(repo_id)
    published_revision = info.sha
    downloaded = api.hf_hub_download(
        repo_id=repo_id,
        repo_type="dataset",
        filename=f"{prefix}/manifest.json",
        revision=published_revision,
    )
    remote_manifest = json.loads(Path(downloaded).read_text(encoding="utf-8"))
    read_back = remote_manifest.get("package_digest") == manifest["package_digest"]
    receipt = {
        "schema_version": "quanthus.hf-dwd-publish-receipt.v1",
        "dataset": repo_id,
        "revision": published_revision,
        "path_prefix": prefix,
        "package_digest": manifest["package_digest"],
        "read_back_verified": read_back,
        "published_at": datetime.now(timezone.utc).isoformat(),
        "local_package": str(staging),
        "fetch_bytes": fetch["member_bytes"],
        "run_wall_seconds": run["wall_seconds"],
    }
    write_json(job / "publish-receipt.json", receipt)
    print(json.dumps(receipt, ensure_ascii=False))
    return 0 if read_back else 1


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name, handler in (
        ("fetch", command_fetch),
        ("screen", command_screen),
        ("publish", command_publish),
    ):
        sub = subparsers.add_parser(name)
        sub.add_argument("--request", type=Path, required=True)
        sub.add_argument("--work", type=Path, required=True)
        sub.set_defaults(handler=handler)
    args = parser.parse_args(argv)
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
