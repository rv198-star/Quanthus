#!/usr/bin/env python3
"""Freeze and report the exact Hermes ODS Base source selection."""

from __future__ import annotations

import argparse
import json
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base import (
    OdsBaseError,
    audit_ods_base_sources,
    load_ods_base_policy,
    write_ods_base_source_inventory,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--astock-root", type=Path, required=True)
    parser.add_argument("--through-date", type=date.fromisoformat, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        inventory = audit_ods_base_sources(
            astock_root=args.astock_root,
            through_date=args.through_date,
            policy=load_ods_base_policy(args.policy),
        )
        write_ods_base_source_inventory(args.output, inventory)
    except (OdsBaseError, FileExistsError, OSError) as exc:
        print(f"ODS Base inventory failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "file_count": inventory["estimated_package"]["file_count"],
                "output": str(args.output.resolve()),
                "selection_digest": inventory["selection_digest"],
                "size_bytes": inventory["estimated_package"]["size_bytes"],
                "through_date": inventory["through_date"],
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
