#!/usr/bin/env bash
# Nightly P12 daily advice run for the isolated 8791 paper account.
#
# Resolves the market date from the bound base24 pointer's DATES index (the
# latest qualified daily) unless P12_MARKET_DATE is pinned.  Issue #743 (r2):
# next_session is resolved inside the job from the P10 forward calendar
# (DEFAULT_CALENDAR_ROOT, or QUANTHUS_P12_CALENDAR_ROOT for a job-local
# replica); the wrapper never reads the retired manifest calendar member
# nor guesses a calendar-day-plus-one.  A calendar the job cannot qualify
# is a whole-day block written to the run receipt.
set -euo pipefail

JOB_ROOT="${QUANTHUS_P12_DAILY_JOB_ROOT:-/srv/quanthus-base22-data/jobs/cn02-standard-daily-base251-a5}"
STATE_DIR="${QUANTHUS_P12_DAILY_STATE_DIR:-${P12_STATE_DIR:-/var/lib/quanthus-p12-isolated}}"
ACCOUNT="${P12_ACCOUNT:-SYN-PAPER-A}"
MARKET_DATE="${P12_MARKET_DATE:-}"
NEXT_SESSION="${P12_NEXT_SESSION:-}"
DECISION_CUTOFF="${QUANTHUS_P12_DECISION_CUTOFF:-}"
# Issue #719 r2 audit: the dedicated P12 venv interpreter (never the host's
# bare python3) runs every python step so the web unit and the nightly job
# share one locked runtime.
PY_BIN="${P12_VENV_PYTHON:-/opt/quanthus/p12-acceptance/venv/bin/python}"
CALENDAR_ROOT="${QUANTHUS_P12_CALENDAR_ROOT:-/srv/agentdock/quanthus-ops/p10-forward-calendar-v1}"

if [ -z "$MARKET_DATE" ]; then
  # Issue #722 r7-5: an unreadable/missing DATES index must still leave a
  # run receipt - the wrapper records the INPUT_BLOCKED day itself rather
  # than exiting with no receipt (the daily job never ran to write one).
  set +e
  MARKET_DATE="$("$PY_BIN" - "$JOB_ROOT" "$STATE_DIR" "$ACCOUNT" "$DECISION_CUTOFF" <<'PY'
import json, sys
from datetime import datetime
from pathlib import Path
try:
    from quanthus.p12_daily.daily_core_input import EXCHANGE_TZ
    from quanthus.p12_daily.package_store import RUN_SCHEMA, DailyPackageStore
except ImportError:
    import os
    for cand in (Path(os.environ.get("QUANTHUS_P12_SRC_ROOT") or "/nonexistent"), Path.cwd() / "src", Path(sys.argv[1]).parent / "src"):
        if (cand / "quanthus/p12_daily/package_store.py").is_file():
            sys.path.insert(0, str(cand))
            break
    from quanthus.p12_daily.daily_core_input import EXCHANGE_TZ
    from quanthus.p12_daily.package_store import RUN_SCHEMA, DailyPackageStore

root, state_dir, account, cutoff = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3], sys.argv[4]
dates = []
try:
    dates = sorted(json.loads((root / "DATES.json").read_text()).get("dates", {}))
    if not dates:
        raise ValueError("no dates in DATES.json")
    print(dates[-1])
except Exception as exc:  # noqa: BLE001 - record the blocked day ourselves
    now = datetime.now(EXCHANGE_TZ)
    rid = now.strftime("%Y%m%dT%H%M%S%f%z")
    md = dates[-1] if dates else now.date().isoformat()
    DailyPackageStore(state_dir).write_run({
        "schema_version": RUN_SCHEMA,
        "run_id": rid,
        "market_date": md,
        "next_session": None,
        "decision_cutoff": cutoff or None,
        "account_id": account,
        "runner": {"ref_id": "p12-daily-run", "version": "wrapper", "digest": ""},
        "started_at": now.isoformat(),
        "stages": [{"stage": "input", "elapsed_ms": 0, "result": "blocked",
                    "reason_code": "INPUT_UNAVAILABLE"}],
        "status": "INPUT_BLOCKED",
        "input_block": {
            "reason_code": "INPUT_UNAVAILABLE",
            "detail": "wrapper could not resolve the market date from "
                      + str(root / "DATES.json") + ": "
                      + type(exc).__name__ + ": " + str(exc),
            "checked_at": now.isoformat(),
            "expected_market_date": None,
            "observed_market_date": None,
            "affected_scope": "new_entries",
            "missing_members": ["DATES.json"],
            "recovery_condition": "restore a readable DATES.json index; "
                                  "the next scheduled run then proceeds",
        },
        "elapsed_ms": 0,
    })
    sys.exit(2)
PY
)"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "p12-daily-run: market-date resolution blocked (receipt written to $STATE_DIR)" >&2
    exit "$rc"
  fi
fi

args=(
    --state-dir "$STATE_DIR"
    --job-root "$JOB_ROOT"
    --account "$ACCOUNT"
    --market-date "$MARKET_DATE"
    --calendar-root "$CALENDAR_ROOT"
)
if [ -n "$NEXT_SESSION" ]; then
    args+=(--next-session "$NEXT_SESSION")
fi
if [ -n "$DECISION_CUTOFF" ]; then
    args+=(--decision-cutoff "${MARKET_DATE}T${DECISION_CUTOFF}")
fi

exec "$PY_BIN" -m quanthus.p12_daily.daily_job "${args[@]}"
