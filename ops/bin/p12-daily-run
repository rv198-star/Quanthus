#!/usr/bin/env bash
# Nightly P12 daily advice run for the isolated 8791 paper account.
#
# Resolves the market date from the bound base24 pointer's DATES index (the
# latest qualified daily) unless P12_MARKET_DATE is pinned, and derives a
# next-session candidate.  The job itself refuses a next_session that the
# governed calendar member does not confirm (M2 F2): a manifest without the
# calendar member is a whole-day block, never a calendar-day-plus-one guess.
set -euo pipefail

JOB_ROOT="${QUANTHUS_P12_DAILY_JOB_ROOT:-/srv/quanthus-base22-data/jobs/cn02-standard-daily-base251-a5}"
STATE_DIR="${QUANTHUS_P12_DAILY_STATE_DIR:-${P12_STATE_DIR:-/var/lib/quanthus-p12-isolated}}"
ACCOUNT="${P12_ACCOUNT:-SYN-PAPER-A}"
MARKET_DATE="${P12_MARKET_DATE:-}"
NEXT_SESSION="${P12_NEXT_SESSION:-}"
DECISION_CUTOFF="${QUANTHUS_P12_DECISION_CUTOFF:-}"

if [ -z "$MARKET_DATE" ]; then
  MARKET_DATE="$(python3 - "$JOB_ROOT" <<'PY'
import json, sys
from pathlib import Path
root = Path(sys.argv[1])
dates = sorted(json.loads((root / "DATES.json").read_text()).get("dates", {}))
if not dates:
    raise SystemExit("no dates in DATES.json")
print(dates[-1])
PY
)"
fi

if [ -z "$NEXT_SESSION" ]; then
  # Audit R6: read the governed calendar's declared next_session from the
  # bound manifest, never a calendar-day-plus-one guess.  A manifest without
  # the calendar member leaves this empty and the job blocks whole-day.
  NEXT_SESSION="$(python3 - "$JOB_ROOT" "$MARKET_DATE" <<'PY'
import json, sys
from pathlib import Path
root = Path(sys.argv[1]); day = sys.argv[2]
try:
    pointer = json.loads((root / "CURRENT_DAILY_CORE_BASE24.json").read_text())
    core = Path(pointer["entry"]["core"])
    if not core.is_absolute():
        core = root / core
    manifest = json.loads((core / "manifest.json").read_text())
    print((manifest.get("calendar") or {}).get("next_session") or "")
except Exception:
    print("")
PY
)"
fi

args=(
    --state-dir "$STATE_DIR"
    --job-root "$JOB_ROOT"
    --account "$ACCOUNT"
    --market-date "$MARKET_DATE"
)
if [ -n "$NEXT_SESSION" ]; then
    args+=(--next-session "$NEXT_SESSION")
fi
if [ -n "$DECISION_CUTOFF" ]; then
    args+=(--decision-cutoff "${MARKET_DATE}T${DECISION_CUTOFF}")
fi

exec python3 -m quanthus.p12_daily.daily_job "${args[@]}"
