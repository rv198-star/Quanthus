#!/usr/bin/env python3
"""Freeze one exact ODS input plan for DWD/DWS v2."""

from __future__ import annotations

import argparse
import json
import sys
from contextlib import ExitStack
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse import (  # noqa: E402
    WarehousePlanningError,
    build_input_plan,
)
from quanthus.pipelines.securities_warehouse.base22_bounded import BoundedError
from quanthus.pipelines.securities_warehouse.base22_sources import SourceAssessmentError


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--ods-package", type=Path, required=True)
    parser.add_argument("--model", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--mode",
        choices=("base", "daily", "weekly", "correction", "backfill", "monthly_base"),
        required=True,
    )
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--knowledge-cutoff", required=True)
    parser.add_argument("--code-revision", required=True)
    parser.add_argument("--runtime-id", required=True)
    parser.add_argument("--market-date")
    parser.add_argument("--through-date")
    parser.add_argument("--monthly-consumer-contract", type=Path)
    parser.add_argument("--monthly-audit-root", type=Path)
    parser.add_argument(
        "--input-identity-override",
        type=Path,
        help="versioned exact ODS Base identity override bound to the base model SHA",
    )
    parser.add_argument(
        "--capacity-root",
        type=Path,
        help="existing filesystem root reserved for DWD/DWS candidate and spill capacity",
    )
    args = parser.parse_args()
    if args.mode == "monthly_base":
        if args.monthly_consumer_contract is None or args.monthly_audit_root is None:
            parser.error(
                "monthly_base requires --monthly-consumer-contract and --monthly-audit-root"
            )
    elif args.monthly_consumer_contract is not None or args.monthly_audit_root is not None:
        parser.error("monthly options require explicit --mode monthly_base")
    try:
        with ExitStack() as stack:
            budget = None
            if args.mode == "monthly_base":
                from quanthus.pipelines.securities_warehouse.base22_bounded import Budget, Limits
                from quanthus.pipelines.securities_warehouse.base22_sources import disjoint_output

                # Check all write locations before the monitor can create scratch.
                sources = [args.ods_package, args.monthly_consumer_contract, args.model]
                audit_root = disjoint_output(args.monthly_audit_root, sources)
                disjoint_output(args.output, [*sources, audit_root])
                budget = stack.enter_context(
                    Budget(
                        audit_root,
                        sources,
                        Limits(
                            allocated_bytes=256 * 1024**2,
                            temp_bytes=128 * 1024**2,
                            free_floor_bytes=8 * 1024**3,
                        ),
                    )
                )
            result = build_input_plan(
                ods_package=args.ods_package,
                model_path=args.model,
                output=args.output,
                mode=args.mode,
                run_id=args.run_id,
                knowledge_cutoff=args.knowledge_cutoff,
                code_revision=args.code_revision,
                runtime_id=args.runtime_id,
                market_date=args.market_date,
                through_date=args.through_date,
                capacity_root=args.capacity_root,
                input_identity_override=args.input_identity_override,
                monthly_consumer_contract=args.monthly_consumer_contract,
                monthly_budget=budget,
            )
    except (WarehousePlanningError, BoundedError, SourceAssessmentError, OSError) as exc:
        print(f"DWD/DWS input planning failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "available_free_bytes": result.available_free_bytes,
                "capacity_sufficient": result.capacity_sufficient,
                "file_count": result.file_count,
                "input_id": result.input_id,
                "input_kind": result.input_kind,
                "input_manifest_sha256": result.input_manifest_sha256,
                "output": str(result.root),
                "plan_digest": result.plan_digest,
                "required_free_bytes": result.required_free_bytes,
                "source_record_count": result.source_record_count,
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
