#!/usr/bin/env python3
"""Freeze one exact ODS input plan for DWD/DWS v2."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse import (  # noqa: E402
    WarehousePlanningError,
    build_input_plan,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--ods-package", type=Path, required=True)
    parser.add_argument("--model", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--mode",
        choices=("base", "daily", "weekly", "correction", "backfill"),
        required=True,
    )
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--knowledge-cutoff", required=True)
    parser.add_argument("--code-revision", required=True)
    parser.add_argument("--runtime-id", required=True)
    parser.add_argument("--market-date")
    parser.add_argument("--through-date")
    parser.add_argument(
        "--input-identity-override",
        type=Path,
        help="versioned exact ODS Base identity override bound to the base model SHA",
    )
    parser.add_argument(
        "--capacity-root",
        type=Path,
        help="existing filesystem root reserved for DWD/DWS candidate and spill capacity",
    )
    args = parser.parse_args()
    try:
        result = build_input_plan(
            ods_package=args.ods_package,
            model_path=args.model,
            output=args.output,
            mode=args.mode,
            run_id=args.run_id,
            knowledge_cutoff=args.knowledge_cutoff,
            code_revision=args.code_revision,
            runtime_id=args.runtime_id,
            market_date=args.market_date,
            through_date=args.through_date,
            capacity_root=args.capacity_root,
            input_identity_override=args.input_identity_override,
        )
    except (WarehousePlanningError, FileExistsError, OSError) as exc:
        print(f"DWD/DWS input planning failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "available_free_bytes": result.available_free_bytes,
                "capacity_sufficient": result.capacity_sufficient,
                "file_count": result.file_count,
                "input_id": result.input_id,
                "input_kind": result.input_kind,
                "input_manifest_sha256": result.input_manifest_sha256,
                "output": str(result.root),
                "plan_digest": result.plan_digest,
                "required_free_bytes": result.required_free_bytes,
                "source_record_count": result.source_record_count,
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
