#!/usr/bin/env python3
"""Prepare an isolated provider workspace for one ODS Base Hotfix."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base_hotfix import (
    OdsBaseHotfixError,
    prepare_hotfix_workspace,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--parent-base", type=Path, required=True)
    parser.add_argument("--audit", type=Path, required=True)
    parser.add_argument("--workspace", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = prepare_hotfix_workspace(
            parent_base=args.parent_base,
            audit_path=args.audit,
            workspace=args.workspace,
        )
    except (OdsBaseHotfixError, OSError) as exc:
        print(f"ODS Base Hotfix preparation failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
