#!/usr/bin/env python3
"""Verify and atomically promote the August CN01 DWD staging rebuild."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
import tempfile
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src"))

from quanthus.pipelines.securities_warehouse import (  # noqa: E402
    DailyDomainBuildError,
    advance_daily_current,
    verify_daily_domain_increment,
)

MARKET_DATES = (
    "2026-08-03",
    "2026-08-04",
    "2026-08-05",
    "2026-08-06",
    "2026-08-07",
    "2026-08-10",
    "2026-08-11",
)


def _object(path: Path) -> dict[str, object]:
    value = json.loads(path.read_text(encoding="ascii"))
    if not isinstance(value, dict):
        raise ValueError(f"JSON root is not an object: {path}")
    return value


def _seal_permissions(root: Path) -> None:
    for path in [root, *root.rglob("*")]:
        if path.is_symlink():
            raise ValueError(f"canonical package contains a symlink: {path}")
        os.chmod(path, 0o2750 if path.is_dir() else 0o640)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--staging-root",
        type=Path,
        default=Path("/srv/quanthus/dwd-dws-v2/daily-rebuild-20260812"),
    )
    parser.add_argument(
        "--canonical-root",
        type=Path,
        default=Path("/srv/quanthus/dwd-dws-v2/daily"),
    )
    args = parser.parse_args()
    staging = args.staging_root.resolve()
    canonical = args.canonical_root.resolve()
    if staging == canonical:
        print("staging root must not be the canonical root", file=sys.stderr)
        return 2

    try:
        staging_pointer = _object(staging / "CURRENT.json")
        if staging_pointer.get("market_date") != MARKET_DATES[-1]:
            raise ValueError("staging CURRENT did not reach 2026-08-11")
        current_path = canonical / "CURRENT.json"
        if current_path.exists():
            current = _object(current_path)
            if date.fromisoformat(str(current["market_date"])) > date.fromisoformat(
                MARKET_DATES[-1]
            ):
                raise ValueError("promotion would move canonical CURRENT backwards")

        verified = []
        for market_date in MARKET_DATES:
            date_root = staging / "packages" / market_date
            packages = [path for path in date_root.iterdir() if path.is_dir()]
            if len(packages) != 1:
                raise ValueError(f"expected exactly one staging package for {market_date}")
            result = verify_daily_domain_increment(packages[0])
            if result.market_date.isoformat() != market_date:
                raise ValueError(f"staging package date differs: {market_date}")
            verified.append(result)
        if staging_pointer.get("manifest_sha256") != verified[-1].manifest_sha256:
            raise ValueError("staging CURRENT does not bind the final verified package")

        canonical.mkdir(parents=True, exist_ok=True)
        for result in verified:
            destination = canonical / "packages" / result.market_date.isoformat() / result.root.name
            if destination.exists():
                _seal_permissions(destination)
                installed = verify_daily_domain_increment(destination)
                if installed.manifest_sha256 != result.manifest_sha256:
                    raise ValueError(f"canonical package collision: {destination}")
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            temporary = Path(
                tempfile.mkdtemp(prefix=f".{destination.name}.", dir=destination.parent)
            )
            try:
                shutil.copytree(result.root, temporary, dirs_exist_ok=True)
                copied = verify_daily_domain_increment(temporary)
                if copied.manifest_sha256 != result.manifest_sha256:
                    raise ValueError(f"copied package differs: {result.market_date}")
                _seal_permissions(temporary)
                os.replace(temporary, destination)
            except BaseException:
                shutil.rmtree(temporary, ignore_errors=True)
                raise

        final = canonical / "packages" / MARKET_DATES[-1] / verified[-1].root.name
        advance_daily_current(package=final, pointer=current_path)
    except (DailyDomainBuildError, OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"CN01 August DWD promotion failed: {exc}", file=sys.stderr)
        return 2

    print(
        json.dumps(
            {
                "market_date": MARKET_DATES[-1],
                "manifest_sha256": verified[-1].manifest_sha256,
                "package_count": len(verified),
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
