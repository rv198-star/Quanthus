#!/usr/bin/env bash
set -euo pipefail
umask 0027

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <development|arbitration|permanent_blind|recent_research> <bundle-id>" >&2
  exit 2
fi
if [[ ${EUID} -ne 0 ]]; then
  echo "strategy-replay ADS publication must run as root" >&2
  exit 2
fi

scope_id=$1
bundle_id=$2
repo_root=${QUANTHUS_REPO_ROOT:-/opt/quanthus/current}
ads_root=${QUANTHUS_STRATEGY_ADS_ROOT:-/srv/quanthus/portable-ads}
source_snapshot=${QUANTHUS_STRATEGY_ADS_SOURCE:-/home/ubuntu/data/quanthus/snapshots/p1-historical-replay-20260729-v1}
benchmark=${QUANTHUS_STRATEGY_ADS_BENCHMARK:-/home/ubuntu/data/quanthus/benchmarks/csi300-sh000300-2012-2025.tencent-v1.json}
industry_mapping=${QUANTHUS_STRATEGY_ADS_INDUSTRY_MAPPING:-/home/ubuntu/data/quanthus/research/p3-governed-industry-mapping-20260729/industry-mapping.json}
ads_policy=${QUANTHUS_STRATEGY_ADS_POLICY:-${repo_root}/config/strategy-replay-ads.v1.json}
corporate_action_policy=${QUANTHUS_STRATEGY_ADS_CORPORATE_ACTION_POLICY:-${repo_root}/config/p1-corporate-action-normalization.v2.json}
python_bin=${QUANTHUS_STRATEGY_ADS_PYTHON:-${repo_root}/.venv/bin/python}

case "${scope_id}" in
  development)
    scope_group=ubuntu
    reader_user=ubuntu
    reader_role=development_research
    ;;
  arbitration)
    scope_group=quanthus-arbitration
    reader_user=quanthus-arbitration
    reader_role=arbitration_operator
    ;;
  permanent_blind)
    scope_group=quanthus-blind
    reader_user=quanthus-blind
    reader_role=blind_evaluation_operator
    ;;
  recent_research)
    scope_group=ubuntu
    reader_user=ubuntu
    reader_role=development_research
    ;;
  *)
    echo "unsupported strategy-replay ADS scope: ${scope_id}" >&2
    exit 2
    ;;
esac

for command in env git getent runuser; do
  command -v "${command}" >/dev/null
done
[[ -x ${python_bin} ]]
[[ -f ${source_snapshot}/snapshot.json ]]
[[ -f ${benchmark} ]]
[[ -f ${industry_mapping} ]]
[[ -f ${ads_policy} ]]
[[ -f ${corporate_action_policy} ]]
getent group "${scope_group}" >/dev/null
id "${reader_user}" >/dev/null

code_revision=$(git -C "${repo_root}" rev-parse HEAD)
git -C "${repo_root}" diff --quiet --ignore-submodules --
git -C "${repo_root}" diff --cached --quiet --ignore-submodules --
if [[ -n $(git -C "${repo_root}" status --porcelain --untracked-files=normal) ]]; then
  echo "repository checkout must be clean before ADS publication" >&2
  exit 2
fi

ads_parent=$(dirname -- "${ads_root}")
if [[ ${ads_root} != /* || $(realpath -m -- "${ads_root}") != "${ads_root}" ]]; then
  echo "strategy-replay ADS root must be an absolute canonical path" >&2
  exit 2
fi
if [[ ! -d ${ads_parent} ]]; then
  install -d -o root -g root -m 0755 "${ads_parent}"
fi
[[ ! -L ${ads_parent} ]]
install -d -o root -g root -m 0751 "${ads_root}"
[[ ! -L ${ads_root} ]]
scope_root=${ads_root}/${scope_id}
install -d -o root -g "${scope_group}" -m 0750 "${scope_root}"
[[ ! -L ${scope_root} ]]
bundle_root=${scope_root}/${bundle_id}

cd "${repo_root}"
PYTHONPATH=src "${python_bin}" -m quanthus build-strategy-replay-ads \
  --source-snapshot-dir "${source_snapshot}" \
  --output "${bundle_root}" \
  --bundle-id "${bundle_id}" \
  --scope-id "${scope_id}" \
  --code-revision "${code_revision}" \
  --benchmark "${benchmark}" \
  --industry-mapping "${industry_mapping}" \
  --ads-policy "${ads_policy}" \
  --corporate-action-policy "${corporate_action_policy}"

chown -R root:"${scope_group}" "${bundle_root}"
find "${bundle_root}" -type d -exec chmod 0750 {} +
find "${bundle_root}" -type f -exec chmod 0640 {} +

PYTHONPATH="${repo_root}/src" "${python_bin}" -m quanthus check-strategy-replay-ads \
  --ads-bundle "${bundle_root}" \
  --reader-role "${reader_role}" \
  --ads-policy "${ads_policy}" \
  --corporate-action-policy "${corporate_action_policy}" >/dev/null

runuser -u "${reader_user}" -- env -C / \
  find "${bundle_root}" -type d -exec test -x {} \;
runuser -u "${reader_user}" -- env -C / \
  find "${bundle_root}" -type f -exec test -r {} \;
reader_writable_path=$(runuser -u "${reader_user}" -- env -C / \
  find "${bundle_root}" -writable -print -quit)
if [[ -n ${reader_writable_path} ]]; then
  echo "${reader_user} can modify strategy-replay ADS path: ${reader_writable_path}" >&2
  exit 1
fi

if [[ ${scope_id} == arbitration || ${scope_id} == permanent_blind ]] \
  && runuser -u ubuntu -- test -r "${bundle_root}/manifest.json"; then
  echo "development principal can read sealed ${scope_id} ADS" >&2
  exit 1
fi

sha256sum "${bundle_root}/manifest.json" "${bundle_root}/READY"
