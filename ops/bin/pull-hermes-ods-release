#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 3 ]]; then
  echo "usage: pull-hermes-ods-release daily|weekly YYYY-MM-DD DEST_ROOT" >&2
  exit 2
fi

schedule="$1"
market_date="$2"
destination_root="$3"
if [[ "$schedule" != "daily" && "$schedule" != "weekly" ]]; then
  echo "schedule must be daily or weekly" >&2
  exit 2
fi
if [[ ! "$market_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "market date must use YYYY-MM-DD" >&2
  exit 2
fi

key_path="${QUANTHUS_HERMES_RSYNC_KEY:?set QUANTHUS_HERMES_RSYNC_KEY}"
known_hosts="${QUANTHUS_HERMES_KNOWN_HOSTS:?set QUANTHUS_HERMES_KNOWN_HOSTS}"
remote_host="${QUANTHUS_HERMES_RSYNC_HOST:-127.0.0.1}"
remote_port="${QUANTHUS_HERMES_RSYNC_PORT:-2222}"
remote_user="${QUANTHUS_HERMES_RSYNC_USER:-astock-ro}"

if [[ ! -f "$key_path" || ! -f "$known_hosts" ]]; then
  echo "Hermes rsync key or pinned known-hosts file is missing" >&2
  exit 2
fi

release_relative="releases/${schedule}/${market_date}"
destination="${destination_root%/}/${release_relative}"
mkdir -p "$destination"

ssh_command="ssh -i ${key_path} -p ${remote_port} -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${known_hosts}"
source_root="${remote_user}@${remote_host}:${release_relative}/"

# READY is deliberately copied last. Consumers still verify its manifest digest and all files.
rsync -a --delay-updates --partial-dir=.rsync-partial --timeout=300 \
  --exclude=/READY -e "$ssh_command" "$source_root" "${destination}/"
rsync -a --delay-updates --timeout=300 \
  -e "$ssh_command" "${source_root}READY" "${destination}/READY"
