#!/usr/bin/env bash
# Restricted RX6800 control surface for AgentDock-mediated Quanthus Stage operations.
set -euo pipefail

fail() {
  echo "quanthus-stage-agentdock-control: $*" >&2
  exit 2
}

[[ "$(id -un)" == "qiuyu" ]] || fail "must run as qiuyu through the admitted sudo rule"
[[ "$(hostname)" == "RX6800" ]] || fail "admitted only on RX6800"

repo_root="/home/qiuyu/quanthus-code/Quanthus"
training_root="/home/qiuyu/quanthus-data/training"
git_key="/home/qiuyu/.ssh/quanthus-github-ro"
worker="${repo_root}/ops/bin/quanthus-stage-worker"
runtime_identity="${training_root}/control/stage-worker/worker-runtime.json"
p014_review_submission="/tmp/quanthus-p014-review-submission.json"
p011_kind="quanthus.stage-orderly-consolidation-joint-d1-prepare.v1"
p012_g1_kind="quanthus.stage-atomic-proposition-g1-prepare.v1"
p013_a_kind="quanthus.stage-development-resource-capacity-census.v1"
p013_c_kind="quanthus.stage-development-resource-plan.v1"
p013_d_kind="quanthus.stage-atomic-proposition-successor-d1-prepare.v1"
p014_a_kind="quanthus.stage-development-resource-admission-screen.v1"
p014_b_kind="quanthus.stage-development-resource-qualified-plan.v1"
p014_c_kind="quanthus.stage-atomic-proposition-admission-qualified-d1-prepare.v1"

[[ -d "${repo_root}/.git" ]] || fail "Quanthus control checkout missing"
[[ -f "${worker}" ]] || fail "stage worker wrapper missing"
[[ -f "${git_key}" ]] || fail "GitHub read-only deploy key missing"

export QUANTHUS_STAGE_CONTROL_REPO="${repo_root}"
export QUANTHUS_STAGE_TRAINING_ROOT="${training_root}"
export QUANTHUS_STAGE_TRAINING_VENV="${repo_root}/.venv-stage-training"
export QUANTHUS_STAGE_GIT_KEY="${git_key}"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export GIT_SSH_COMMAND="ssh -F none -i ${git_key} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/qiuyu/.ssh/known_hosts -o GlobalKnownHostsFile=/dev/null"

exact_revision() {
  [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]] || fail "exact 40-character revision required"
}

service_revision() {
  [[ -f "${runtime_identity}" ]] || fail "worker runtime identity missing"
  "${repo_root}/.venv-stage-training/bin/python" -c \
    'import json,sys; value=json.load(open(sys.argv[1])); print(value.get("code_revision", ""))' \
    "${runtime_identity}"
}

restart_and_verify() {
  systemctl --user restart quanthus-stage-worker.service
  for _ in $(seq 1 20); do
    systemctl --user is-active --quiet quanthus-stage-worker.service && break
    sleep 1
  done
  systemctl --user is-active --quiet quanthus-stage-worker.service || fail "worker service inactive"
  local expected="$1"
  local observed=""
  for _ in $(seq 1 20); do
    observed="$(service_revision 2>/dev/null || true)"
    [[ "${observed}" == "${expected}" ]] && break
    sleep 1
  done
  [[ "${observed}" == "${expected}" ]] || fail "worker runtime revision differs"
  bash "${worker}" doctor
}

command="${1:-}"
case "${command}" in
  deploy)
    [[ "$#" -eq 2 ]] || fail "usage: deploy <exact-main-revision>"
    target="$2"
    exact_revision "${target}"
    [[ -z "$(git -C "${repo_root}" status --porcelain)" ]] || fail "control checkout must be clean"
    git -C "${repo_root}" fetch --no-tags git@github.com:rv198-star/Quanthus.git \
      "+refs/heads/main:refs/remotes/stage-control/main"
    remote_main="$(git -C "${repo_root}" rev-parse refs/remotes/stage-control/main)"
    [[ "${target}" == "${remote_main}" ]] || fail "target must equal current GitHub main"
    git -C "${repo_root}" checkout --detach "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "checkout revision differs"
    restart_and_verify "${target}"
    ;;
  doctor)
    [[ "$#" -eq 1 ]] || fail "usage: doctor"
    bash "${worker}" doctor
    ;;
  submit-p011-d1)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p011-d1 <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p011_kind}" --code-revision "${target}"
    ;;
  submit-p012-g1)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p012-g1 <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p012_g1_kind}" --code-revision "${target}"
    ;;
  submit-p013-a)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p013-a <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p013_a_kind}" --code-revision "${target}"
    ;;
  submit-p013-c)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p013-c <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p013_c_kind}" --code-revision "${target}"
    ;;
  submit-p013-d)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p013-d <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p013_d_kind}" --code-revision "${target}"
    ;;
  submit-p014-a)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p014-a <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p014_a_kind}" --code-revision "${target}"
    ;;
  submit-p014-b)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p014-b <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p014_b_kind}" --code-revision "${target}"
    ;;
  submit-p014-c)
    [[ "$#" -eq 2 ]] || fail "usage: submit-p014-c <exact-revision>"
    target="$2"
    exact_revision "${target}"
    [[ "$(git -C "${repo_root}" rev-parse HEAD)" == "${target}" ]] || fail "control checkout revision differs"
    [[ "$(service_revision)" == "${target}" ]] || fail "worker runtime revision differs"
    bash "${worker}" submit --kind "${p014_c_kind}" --code-revision "${target}"
    ;;
  seal-p014-review)
    [[ "$#" -eq 2 ]] || fail "usage: seal-p014-review <stage_job_id>"
    [[ "$2" =~ ^stage_[0-9a-f]{32}$ ]] || fail "valid stage job id required"
    [[ -f "${p014_review_submission}" && ! -L "${p014_review_submission}" ]] \
      || fail "fixed P014 review submission missing or symlinked"
    [[ "$(stat -c '%U:%G' "${p014_review_submission}")" == "agentdock:agentdock" ]] \
      || fail "fixed P014 review submission owner differs"
    [[ "$(stat -c '%a' "${p014_review_submission}")" == "644" ]] \
      || fail "fixed P014 review submission mode differs"
    [[ "$(stat -c '%s' "${p014_review_submission}")" -le 524288 ]] \
      || fail "fixed P014 review submission exceeds size budget"
    cat "${p014_review_submission}" | bash "${worker}" seal-p014-review --job-id "$2"
    ;;
  status)
    [[ "$#" -eq 2 ]] || fail "usage: status <stage_job_id>"
    [[ "$2" =~ ^stage_[0-9a-f]{32}$ ]] || fail "valid stage job id required"
    bash "${worker}" status --job-id "$2"
    ;;
  *)
    fail "allowed commands: deploy | doctor | submit-p011-d1 | submit-p012-g1 | submit-p013-a | submit-p013-c | submit-p013-d | submit-p014-a | submit-p014-b | submit-p014-c | seal-p014-review | status"
    ;;
esac
