#!/usr/bin/env bash
# Stable node-local entry point for the governed RX6800 stage worker.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="${QUANTHUS_STAGE_CONTROL_REPO:-$(cd -- "${script_dir}/../.." && pwd)}"
venv_root="${QUANTHUS_STAGE_TRAINING_VENV:-${repo_root}/.venv-stage-training}"
training_root="${QUANTHUS_STAGE_TRAINING_ROOT:-${HOME}/quanthus-data/training}"
git_key="${QUANTHUS_STAGE_GIT_KEY:-${HOME}/.ssh/quanthus-github-ro}"

if [[ ! -x "${venv_root}/bin/python" ]]; then
  echo "quanthus-stage-worker: stage-training virtualenv is missing" >&2
  exit 2
fi

control_revision="$(git -C "${repo_root}" rev-parse HEAD)"
if [[ ! "${control_revision}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "quanthus-stage-worker: control checkout revision is invalid" >&2
  exit 2
fi
export QUANTHUS_STAGE_WORKER_CODE_REVISION="${control_revision}"
export PYTHONPATH="${repo_root}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${venv_root}/bin/python" -m quanthus.stage_learning.worker \
  --training-root "${training_root}" \
  --control-repo "${repo_root}" \
  --git-key "${git_key}" \
  "$@"
