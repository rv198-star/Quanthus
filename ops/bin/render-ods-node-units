#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 --node-id <hermes|cn01|node-name> --output <directory>" >&2
}

NODE_ID=""
OUTPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --node-id) NODE_ID="${2:-}"; shift 2 ;;
    --output) OUTPUT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

if [[ ! "$NODE_ID" =~ ^[a-z][a-z0-9-]*$ ]] || [[ -z "$OUTPUT" ]]; then
  usage
  exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SOURCE_DIR="${ROOT}/ops/systemd"
mkdir -p "$OUTPUT"

UNITS=(
  hermes-ods-weekly-corrections.service
  hermes-ods-weekly-corrections.timer
)

if [[ "$NODE_ID" == "cn01" ]]; then
  # CN01 owns one daily control-plane timer.  The old lane timers are still rendered
  # as explicit rollback units, but are disabled unless the operator creates this marker.
  UNITS+=(
    hermes-ods-daily-orchestrator.service
    hermes-ods-daily-orchestrator.timer
    hermes-ods-market-daily-core.service
    hermes-ods-market-daily-core.timer
    hermes-ods-calendar-daily-events.service
    hermes-ods-calendar-daily-events.timer
    hermes-ods-intraday-1m.service
    hermes-ods-intraday-1m.timer
    hermes-ods-intraday-5m.service
    hermes-ods-intraday-5m.timer
  )
else
  UNITS+=(
    hermes-ods-market-daily-core.service
    hermes-ods-market-daily-core.timer
    hermes-ods-calendar-daily-events.service
    hermes-ods-calendar-daily-events.timer
    hermes-ods-intraday-1m.service
    hermes-ods-intraday-1m.timer
    hermes-ods-intraday-5m.service
    hermes-ods-intraday-5m.timer
  )
fi

UNITS+=(quanthus-pipeline-failure@.service)

for unit in "${UNITS[@]}"; do
  source_path="${SOURCE_DIR}/${unit}"
  target_name="${unit/hermes-ods/${NODE_ID}-ods}"
  target_path="${OUTPUT}/${target_name}"
  tmp_path="${target_path}.tmp.$$"
  sed "s/hermes-ods/${NODE_ID}-ods/g" "$source_path" > "$tmp_path"
  sed -i "s/run-${NODE_ID}-ods-lane/run-hermes-ods-lane/g" "$tmp_path"
  sed -i "s/HERMES_ODS_NODE_ID=hermes/HERMES_ODS_NODE_ID=${NODE_ID}/g" "$tmp_path"
  sed -i "s/--node-id hermes/--node-id ${NODE_ID}/g" "$tmp_path"
  if [[ "$NODE_ID" == "cn01" && "$unit" == "hermes-ods-market-daily-core.timer" ]]; then
    sed -i "s/Hermes ODS/CN01 ODS/g; s/17:30:00/18:30:00/g; s/contract 17:30/contract 18:30/g; s/collection window/throughput-budgeted collection window/g" "$tmp_path"
  fi
  if [[ "$NODE_ID" == "cn01" && "$unit" == "hermes-ods-market-daily-core.service" ]]; then
    sed -i "s/TimeoutStartSec=4h10min/TimeoutStartSec=80min/g" "$tmp_path"
  fi
  if [[ "$NODE_ID" == "cn01" && "$unit" =~ ^hermes-ods-(market-daily-core|calendar-daily-events|intraday-1m|intraday-5m)\.(service|timer)$ ]]; then
    sed -i '0,/^\[Unit\]$/s//[Unit]\nConditionPathExists=\/etc\/quanthus\/cn01-ods-legacy-timers-enabled/' "$tmp_path"
  fi
  chmod 0644 "$tmp_path"
  mv "$tmp_path" "$target_path"
done

echo "rendered ${#UNITS[@]} ODS units for ${NODE_ID} under ${OUTPUT}"
