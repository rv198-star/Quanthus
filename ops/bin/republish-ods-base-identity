#!/usr/bin/env python3
"""Republish one verified ODS Base under a new immutable identity."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base import load_ods_base_policy  # noqa: E402
from quanthus.pipelines.ods_base_rollup import (  # noqa: E402
    OdsBaseRollupError,
    republish_ods_base_identity,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--bundle-id", required=True)
    parser.add_argument("--code-revision", required=True)
    parser.add_argument("--built-at", required=True)
    parser.add_argument("--expected-source-manifest-sha256", required=True)
    parser.add_argument("--expected-source-content-digest", required=True)
    args = parser.parse_args()
    try:
        result = republish_ods_base_identity(
            source_bundle=args.source,
            output=args.output,
            bundle_id=args.bundle_id,
            policy=load_ods_base_policy(args.policy),
            code_revision=args.code_revision,
            built_at=args.built_at,
            expected_source_manifest_sha256=args.expected_source_manifest_sha256,
            expected_source_content_digest=args.expected_source_content_digest,
        )
    except (OdsBaseRollupError, FileExistsError, OSError) as exc:
        print(f"ODS Base identity republish failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.__dict__, default=str, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
