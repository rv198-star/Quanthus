#!/usr/bin/env python3
"""Run the complete CN01 four-lane ODS to Base-seeded DWD daily workflow."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src"))

from quanthus.pipelines.securities_warehouse.daily_core_domain import (  # noqa: E402
    DailyDomainBuildError,
    advance_daily_current,
    build_daily_domain_increment,
    verify_daily_domain_increment,
)
from quanthus.pipelines.securities_warehouse.daily_core_ods_catalog import (  # noqa: E402
    DAILY_CORE_PRODUCT_SCOPE,
    LEGACY_PRODUCT_SCOPE,
    DailyOdsCatalogError,
    build_daily_ods_catalog,
)


def _seal_for_read_only_sync(root: Path) -> None:
    """Make an immutable daily package traversable by the read-only sync group."""

    for path in [root, *root.rglob("*")]:
        if path.is_symlink():
            raise DailyDomainBuildError(f"daily DWD package contains a symlink: {path}")
        os.chmod(path, 0o2750 if path.is_dir() else 0o640)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--market-date")
    parser.add_argument("--release-root", type=Path, required=True)
    parser.add_argument("--base", type=Path, required=True)
    parser.add_argument("--release-config", type=Path, required=True)
    parser.add_argument("--daily-root", type=Path, required=True)
    parser.add_argument(
        "--product-scope",
        choices=(LEGACY_PRODUCT_SCOPE, DAILY_CORE_PRODUCT_SCOPE),
        default=LEGACY_PRODUCT_SCOPE,
    )
    parser.add_argument(
        "--bootstrap-prior-pointer",
        type=Path,
        help="explicit read-only legacy 2026-09-23 prior for first daily-core restore",
    )
    args = parser.parse_args()
    market_date = (
        datetime.strptime(args.market_date, "%Y-%m-%d").date()
        if args.market_date
        else datetime.now(ZoneInfo("Asia/Shanghai")).date()
    )
    try:
        is_core = args.product_scope == DAILY_CORE_PRODUCT_SCOPE
        if is_core and (args.daily_root / "CURRENT.json").exists():
            raise DailyDomainBuildError("daily-core root already contains legacy CURRENT")
        current = args.daily_root / ("CURRENT_DAILY_CORE.json" if is_core else "CURRENT.json")
        prior_pointer = current
        if args.bootstrap_prior_pointer is not None:
            if not is_core or current.exists() or market_date.isoformat() != "2026-09-24":
                raise DailyDomainBuildError(
                    "legacy-prior bootstrap only allowed for the first 2026-09-24 core build"
                )
            prior = json.loads(args.bootstrap_prior_pointer.read_text(encoding="ascii"))
            if (
                prior.get("kind") != "cn01_daily_dwd_current"
                or prior.get("market_date") != "2026-09-23"
            ):
                raise DailyDomainBuildError(
                    "bootstrap prior is not the pinned 2026-09-23 legacy DWD"
                )
            prior_manifest = (
                args.bootstrap_prior_pointer.parent / prior["manifest_path"]
            ).resolve()
            checked_prior = verify_daily_domain_increment(prior_manifest.parent)
            if (
                checked_prior.market_date.isoformat() != "2026-09-23"
                or checked_prior.manifest_sha256 != prior.get("manifest_sha256")
            ):
                raise DailyDomainBuildError("daily-core bootstrap prior bytes/date do not match")
            prior_pointer = args.bootstrap_prior_pointer
        elif is_core and not current.exists():
            raise DailyDomainBuildError(
                "daily-core first build needs explicit approved prior pointer; no Base-era gap skip"
            )
        if current.exists():
            descriptor = json.loads(current.read_text(encoding="ascii"))
            if descriptor.get("market_date") == market_date.isoformat():
                manifest = (current.parent / descriptor["manifest_path"]).resolve()
                result = verify_daily_domain_increment(manifest.parent)
                print(json.dumps(result.__dict__, default=str, sort_keys=True))
                return 0
        revision = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        catalog = build_daily_ods_catalog(
            release_root=args.release_root,
            market_date=market_date,
            output=args.daily_root / "catalogs" / market_date.isoformat(),
            product_scope=args.product_scope,
        )
        output = (
            args.daily_root
            / "packages"
            / market_date.isoformat()
            / f"{catalog.catalog_digest.removeprefix('sha256:')[:12]}-{revision[:7]}"
        )
        result = build_daily_domain_increment(
            catalog_root=catalog.root,
            release_root=args.release_root,
            base_root=args.base,
            release_config=args.release_config,
            output=output,
            code_revision=revision,
            prior_pointer=prior_pointer,
        )
        _seal_for_read_only_sync(result.root)
        advance_daily_current(package=result.root, pointer=current)
    except (
        DailyDomainBuildError,
        DailyOdsCatalogError,
        OSError,
        ValueError,
        subprocess.CalledProcessError,
    ) as exc:
        print(f"CN01 daily ODS->DWD workflow failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.__dict__, default=str, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
