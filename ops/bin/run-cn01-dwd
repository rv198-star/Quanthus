#!/usr/bin/env python3
"""Seal one CN01 DWD daily or weekly input run.

This command is intentionally a control-plane entry point.  It prepares and verifies the exact
ODS input and Base bindings; it does not run the legacy seven-table DWD builder and it does not
advance any consumer pointer.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from datetime import date, datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src"))

from quanthus.pipelines.securities_warehouse.dwd_schedule import (  # noqa: E402
    DwdScheduleError,
    prepare_dwd_schedule_run,
)


def _revision(root: Path) -> str:
    return subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=root,
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", choices=("daily", "weekly"), required=True)
    parser.add_argument("--market-date", type=date.fromisoformat)
    parser.add_argument("--release-root", type=Path, required=True)
    parser.add_argument("--ods-base", type=Path, required=True)
    parser.add_argument("--dwd-base", type=Path, required=True)
    parser.add_argument("--release-config", type=Path, required=True)
    parser.add_argument("--run-root", type=Path, required=True)
    parser.add_argument("--run-id")
    parser.add_argument("--code-revision")
    parser.add_argument("--wait-seconds", type=int, default=0)
    parser.add_argument("--poll-seconds", type=int, default=30)
    args = parser.parse_args()
    market_date = args.market_date or datetime.now(ZoneInfo("Asia/Shanghai")).date()
    run_id = args.run_id or f"cn01-dwd-{args.mode}-{market_date.strftime('%Y%m%d')}"
    if args.wait_seconds < 0 or args.poll_seconds < 1:
        parser.error("--wait-seconds must be nonnegative and --poll-seconds must be positive")
    try:
        revision = args.code_revision or _revision(ROOT)
        deadline = time.monotonic() + args.wait_seconds
        while True:
            try:
                result = prepare_dwd_schedule_run(
                    mode=args.mode,
                    market_date=market_date,
                    release_root=args.release_root,
                    ods_base=args.ods_base,
                    dwd_base=args.dwd_base,
                    release_config=args.release_config,
                    output=args.run_root / args.mode / market_date.isoformat() / run_id,
                    run_id=run_id,
                    code_revision=revision,
                )
                break
            except DwdScheduleError as exc:
                # ODS acquisition completion, not the timer wall clock, is the gate. Other
                # validation failures are deterministic and must fail immediately.
                retryable = "absent or not READY" in str(exc)
                if not retryable or time.monotonic() >= deadline:
                    raise
                time.sleep(min(args.poll_seconds, max(1, int(deadline - time.monotonic()))))
    except (DwdScheduleError, OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"CN01 DWD {args.mode} input preparation failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.__dict__, default=str, ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
