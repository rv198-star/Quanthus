#!/usr/bin/env python3
"""Run the CN01 daily ODS lanes and hand off a sealed input to DWD."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src"))

from quanthus.pipelines.process_control import (  # noqa: E402
    PROCESS_CLEANUP_FAILED,
    ProcessGroupCleanupError,
    terminate_process_group,
)
from quanthus.pipelines.securities_warehouse.daily_ods_catalog import (  # noqa: E402
    find_ready_daily_ods_lanes,
)
from quanthus.pipelines.source_maturity import source_maturity_deferred  # noqa: E402
from quanthus.pipelines.trading_maturity import (  # noqa: E402
    NonTradingSessionDate,
    minute_maturity_eligible,
    verified_next_session,
)

SHANGHAI = ZoneInfo("Asia/Shanghai")
UTC = timezone.utc
_ENV_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

_CATALOG_LANES = {
    "market-daily-core": "market_daily_core",
    "calendar-daily-events": "calendar_daily_events",
    "intraday-1m": "intraday_1m",
    "intraday-5m": "intraday_5m",
}

# This return status is deliberately distinct from a failed ODS/DWD run.  Tencent
# exposes the current session's 1m volumes in whole lots, while the sealed daily
# source records exact shares (including odd lots).  A same-day mismatch is thus
# not safe to publish, but it is also not repaired by repeating the full scan.
# The maturity recovery timer retries that exact date only after the source has
# had time to publish its historical representation.
SOURCE_MATURITY_DEFERRED = 3


def _load_env_file(path: Path) -> None:
    """Load the simple KEY=VALUE env files used by the systemd units."""

    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if not _ENV_KEY.fullmatch(key):
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        os.environ.setdefault(key, value)


def _load_node_environment() -> None:
    node_id = os.environ.get("HERMES_ODS_NODE_ID", "cn01")
    default_name = "cn01-ods-lane.env" if node_id == "cn01" else "hermes-ods-lane.env"
    env_file = Path(os.environ.get("HERMES_ODS_ENV_FILE", f"/etc/quanthus/{default_name}"))
    _load_env_file(env_file)
    dwd_env = os.environ.get("QUANTHUS_DWD_ENV_FILE")
    if dwd_env:
        _load_env_file(Path(dwd_env))


def _now() -> datetime:
    return datetime.now(UTC)


def _iso(value: datetime) -> str:
    return value.astimezone(UTC).isoformat().replace("+00:00", "Z")


def _atomic_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(payload, ensure_ascii=True, sort_keys=True, indent=2) + "\n",
        encoding="ascii",
    )
    os.replace(temporary, path)


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def _closed_lane_receipt(log_path: Path, market_date: date) -> bool:
    """Require a dated, explicit closed-session receipt from a completed lane."""

    try:
        payload = json.loads(log_path.read_text(encoding="utf-8").splitlines()[-1])
    except (OSError, ValueError, IndexError):
        return False
    return (
        isinstance(payload, dict)
        and payload.get("status") == "closed_session"
        and payload.get("preflight") == "both_closed"
        and payload.get("market_date") == market_date.isoformat()
    )


def _closed_verified_release(verified: Any, market_date: date) -> bool:
    """Recognize a checksum-verified calendar-only release reused by a retry."""

    artifacts = verified.release.artifacts
    if {artifact.name for artifact in artifacts} != {"trading_calendar", "lane_status"}:
        return False
    return any(
        artifact.name == "trading_calendar"
        and artifact.source_revision.startswith(
            f"calendar-closed-{market_date.strftime('%Y%m%d')}-"
        )
        for artifact in artifacts
    )


def _duration(deadline: float) -> float:
    return max(1.0, deadline - time.monotonic())


@dataclass
class LaneJob:
    lane: str
    command: list[str]
    log_root: Path
    retry_on_busy: bool = False
    poll_seconds: float = 15.0
    attempt: int = 0
    process: subprocess.Popen[bytes] | None = None
    log_handle: Any = None
    next_start_at: float = 0.0
    logs: list[str] = field(default_factory=list)
    termination_grace_seconds: float = 10.0

    def start(self) -> None:
        self.attempt += 1
        log_path = self.log_root / f"{self.lane.replace('/', '-')}-{self.attempt}.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self.log_handle = log_path.open("wb")
        self.logs.append(str(log_path))
        try:
            self.process = subprocess.Popen(
                self.command,
                stdout=self.log_handle,
                stderr=subprocess.STDOUT,
                env=os.environ.copy(),
                start_new_session=True,
            )
        except OSError as exc:
            self.log_handle.write(f"command failed to start: {exc}\n".encode())
            self.log_handle.close()
            self.log_handle = None
            raise

    def poll(self) -> tuple[str, int | None]:
        if self.process is None:
            return "waiting", None
        returncode = self.process.poll()
        if returncode is None:
            return "running", None
        # A shell may have exited before its descendants. Never lose ownership
        # or retry a busy lock until all writers in this group have stopped.
        self.terminate()
        log_text = Path(self.logs[-1]).read_text(encoding="utf-8", errors="replace")
        if returncode != 0 and self.retry_on_busy and "lock busy" in log_text.lower():
            return "retry", returncode
        return "done", returncode

    def terminate(self) -> None:
        if self.process is None:
            return
        try:
            terminate_process_group(self.process, grace_seconds=self.termination_grace_seconds)
            self.process = None
        finally:
            if self.log_handle is not None:
                self.log_handle.close()
                self.log_handle = None


def _lane_command(
    runner: Path,
    lane: str,
    market_date: date,
    *,
    stream: str | None,
    home: Path,
    shadow_root: Path,
    calendar: Path,
    config: Path,
    recovery_deadline_at: datetime | None = None,
) -> list[str]:
    command = [
        str(runner),
        "--lane",
        lane,
        "--market-date",
        market_date.isoformat(),
        "--home",
        str(home),
        "--shadow-root",
        str(shadow_root),
        "--calendar",
        str(calendar),
        "--config",
        str(config),
    ]
    if stream:
        command.extend(["--stream", stream])
    if recovery_deadline_at is not None:
        command.extend(["--recovery-deadline-at", recovery_deadline_at.isoformat()])
    return command


def _run_group(
    jobs: list[LaneJob],
    *,
    deadline: float,
    poll_seconds: float,
) -> dict[str, dict[str, Any]]:
    try:
        return _run_group_owned(jobs, deadline=deadline, poll_seconds=poll_seconds)
    finally:
        # Includes partially started groups and Python interruption paths. One
        # cleanup error must not skip cleanup of the remaining owned groups.
        cleanup_errors = []
        for job in jobs:
            try:
                job.terminate()
            except ProcessGroupCleanupError as exc:
                cleanup_errors.append(str(exc))
        if cleanup_errors:
            raise ProcessGroupCleanupError("; ".join(cleanup_errors))


def _run_group_owned(
    jobs: list[LaneJob],
    *,
    deadline: float,
    poll_seconds: float,
) -> dict[str, dict[str, Any]]:
    for job in jobs:
        if time.monotonic() >= deadline:
            break
        job.start()
    pending = list(jobs)
    results: dict[str, dict[str, Any]] = {}
    while pending:
        if time.monotonic() >= deadline:
            for job in pending:
                job.terminate()
                results[job.lane] = {
                    "status": "sla_exceeded",
                    "returncode": None,
                    "attempts": job.attempt,
                    "logs": job.logs,
                }
            break
        now = time.monotonic()
        for job in list(pending):
            if job.process is None:
                if now < job.next_start_at:
                    continue
                job.start()
                continue
            state, returncode = job.poll()
            if state == "running":
                continue
            if state == "retry" and time.monotonic() < deadline:
                job.next_start_at = time.monotonic() + min(poll_seconds, job.poll_seconds)
                continue
            pending.remove(job)
            status = "ready" if returncode == 0 else "failed"
            results[job.lane] = {
                "status": status,
                "returncode": returncode,
                "attempts": job.attempt,
                "logs": job.logs,
            }
        if pending:
            time.sleep(min(1.0, _duration(deadline)))
    return results


def _run_command(
    command: list[str],
    *,
    log_path: Path,
    timeout: float,
) -> tuple[int, str]:
    try:
        return _run_command_owned(command, log_path=log_path, timeout=timeout)
    except ProcessGroupCleanupError as exc:
        with log_path.open("ab") as stream:
            stream.write(f"{exc}\n".encode())
        return PROCESS_CLEANUP_FAILED, str(log_path)


def _run_command_owned(
    command: list[str],
    *,
    log_path: Path,
    timeout: float,
) -> tuple[int, str]:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("wb") as stream:
        process = None
        try:
            process = subprocess.Popen(
                command,
                stdout=stream,
                stderr=subprocess.STDOUT,
                env=os.environ.copy(),
                start_new_session=True,
            )
            return process.wait(timeout=max(1.0, timeout)), str(log_path)
        except subprocess.TimeoutExpired:
            return 124, str(log_path)
        except OSError as exc:
            stream.write(f"command failed to start: {exc}\n".encode())
            return 127, str(log_path)
        finally:
            if process is not None:
                terminate_process_group(process)


def _write_run_state(run_root: Path, state: dict[str, Any], *, ready: bool) -> None:
    manifest = run_root / "run.json"
    _atomic_json(manifest, state)
    ready_path = run_root / "READY"
    if ready:
        ready_path.write_text(_sha256(manifest) + "\n", encoding="ascii")
    else:
        ready_path.unlink(missing_ok=True)


def main() -> int:
    _load_node_environment()
    parser = argparse.ArgumentParser()
    parser.add_argument("--market-date", type=date.fromisoformat)
    parser.add_argument("--sla-seconds", type=int)
    parser.add_argument("--dwd-sla-seconds", type=int)
    parser.add_argument("--poll-seconds", type=float)
    parser.add_argument(
        "--recovery-window-seconds",
        type=int,
        help="give a retry an explicit market acquisition window from its start time",
    )
    parser.add_argument(
        "--ods-only",
        action="store_true",
        help="seal the ODS lanes and catalog without starting the daily DWD build",
    )
    parser.add_argument(
        "--minute-maturity-policy",
        choices=("same-day-probe", "next-trading-day"),
        default=os.environ.get("QUANTHUS_ODS_MINUTE_MATURITY_POLICY", "same-day-probe"),
        help="next-trading-day defers real 1m acquisition until a verified trading session",
    )
    args = parser.parse_args()

    node_id = os.environ.get("HERMES_ODS_NODE_ID", "cn01").strip().lower()
    if re.fullmatch(r"[a-z][a-z0-9-]*", node_id) is None:
        parser.error("HERMES_ODS_NODE_ID must be a normalized node id")
    market_date = args.market_date or datetime.now(SHANGHAI).date()
    sla_seconds = args.sla_seconds or int(os.environ.get("HERMES_ODS_DAILY_SLA_SECONDS", "5400"))
    dwd_sla_seconds = args.dwd_sla_seconds or int(
        os.environ.get("QUANTHUS_DWD_DAILY_SLA_SECONDS", "3600")
    )
    poll_seconds = args.poll_seconds or float(
        os.environ.get("HERMES_ODS_ORCHESTRATOR_POLL_SECONDS", "15")
    )
    if (
        sla_seconds <= 0
        or dwd_sla_seconds <= 0
        or poll_seconds <= 0
        or (args.recovery_window_seconds is not None and args.recovery_window_seconds <= 0)
    ):
        parser.error("SLA and poll intervals must be positive")

    astock_root = Path(os.environ.get("ASTOCK_ROOT", "/root/work/astock"))
    home = Path(os.environ.get("ASTOCK_HOME", str(astock_root / "data")))
    shadow_root = Path(os.environ.get("HERMES_ODS_SHADOW_ROOT", str(home / "shadow/cn01-ods-v1")))
    release_root = Path(os.environ.get("HERMES_ODS_RELEASE_ROOT", str(shadow_root / "releases")))
    calendar = Path(
        os.environ.get("HERMES_ODS_CALENDAR", str(home / "ref_trading_calendar.parquet"))
    )
    config = Path(
        os.environ.get(
            "HERMES_ODS_SCHEDULE", str(ROOT / "config/schedules/hermes-ods-schedule.v1.json")
        )
    )
    runner = Path(os.environ.get("HERMES_ODS_RUNNER", str(ROOT / "ops/bin/run-hermes-ods-lane")))
    catalog_builder = Path(
        os.environ.get(
            "HERMES_ODS_CATALOG_BUILDER", str(ROOT / "ops/bin/build-cn01-daily-ods-catalog")
        )
    )
    dwd_runner = Path(
        os.environ.get("QUANTHUS_DWD_DAILY_RUNNER")
        or os.environ.get("QUANTHUS_DWD_RUNNER")
        or str(ROOT / "ops/bin/run-cn01-daily-dwd")
    )
    dwd_python = Path(os.environ.get("QUANTHUS_DWD_PYTHON", str(ROOT / ".venv-p1/bin/python")))
    if not dwd_python.is_file():
        dwd_python = Path(sys.executable)

    maturity_evidence = None
    defer_one_minute = False
    if args.minute_maturity_policy == "next-trading-day":
        try:
            maturity_evidence = verified_next_session(market_date)
            defer_one_minute = not minute_maturity_eligible(
                market_date, datetime.now(SHANGHAI), maturity_evidence
            )
        except NonTradingSessionDate:
            # Let existing explicit closed-session lane receipts control a
            # non-trading date; do not turn holidays into false source alarms.
            defer_one_minute = False
        except (OSError, RuntimeError, ValueError) as exc:
            print(
                json.dumps(
                    {
                        "status": "blocked_trading_calendar_unverified",
                        "market_date": market_date.isoformat(),
                        "error": type(exc).__name__,
                    }
                )
            )
            return 2

    started = _now()
    if args.recovery_window_seconds is not None:
        sla_seconds = args.recovery_window_seconds
    deadline = time.monotonic() + sla_seconds
    market_recovery_deadline = (
        started + timedelta(seconds=sla_seconds)
        if args.recovery_window_seconds is not None
        or (args.ods_only and market_date < datetime.now(SHANGHAI).date())
        else None
    )
    run_id = started.strftime("%Y%m%dT%H%M%S%fZ")
    run_root = shadow_root / "orchestrator" / "daily" / market_date.isoformat() / run_id
    log_root = run_root / "logs"
    catalog_root = Path(
        os.environ.get(
            "HERMES_ODS_DAILY_CATALOG_ROOT",
            str(shadow_root / "catalogs/daily" / market_date.isoformat() / run_id),
        )
    )
    run_root.mkdir(parents=True, exist_ok=False)
    os.environ["HERMES_ODS_NODE_ID"] = node_id
    os.environ.setdefault("HERMES_ODS_ENV_FILE", f"/etc/quanthus/{node_id}-ods-lane.env")
    notification_context_path = shadow_root / "orchestrator/daily/notification-context.json"
    notification_context: dict[str, Any] = {
        "schema_version": 1,
        "kind": "ods_daily_orchestration_notification_context",
        "market_date": market_date.isoformat(),
        "node": "CN01" if node_id == "cn01" else node_id.title(),
        "stage": "ods_to_dwd_build",
        "unit": f"{node_id}-ods-daily-orchestrator.service",
        "run_path": str(run_root),
        "error_code": "orchestrator_failed",
        "error": "ODS-to-DWD orchestrator did not reach READY",
        "started_at": _iso(started),
        "status": "running",
    }
    _atomic_json(notification_context_path, notification_context)

    common = {
        "runner": str(runner),
        "market_date": market_date.isoformat(),
        "shadow_root": str(shadow_root),
        "release_root": str(release_root),
        "ods_sla_seconds": sla_seconds,
        "dwd_sla_seconds": dwd_sla_seconds,
        "market_recovery_deadline_at": (
            market_recovery_deadline.isoformat() if market_recovery_deadline else None
        ),
        "started_at": _iso(started),
    }
    state: dict[str, Any] = {
        "schema_version": 1,
        "kind": "ods_daily_orchestration",
        "node": node_id,
        "mode": "ods_only" if args.ods_only else "ods_to_dwd",
        "minute_maturity_policy": args.minute_maturity_policy,
        "minute_maturity_calendar": (
            {
                "source": maturity_evidence.source,
                "next_session": maturity_evidence.next_session.isoformat(),
                "sha256": maturity_evidence.calendar_sha256,
            }
            if maturity_evidence is not None
            else None
        ),
        **common,
        "status": "acquiring",
        "lanes": {},
        "catalog": None,
        "dwd": None,
    }

    daily_group = [
        LaneJob(
            lane="market-daily-core",
            command=_lane_command(
                runner,
                "market-daily-core",
                market_date,
                stream=None,
                home=home,
                shadow_root=shadow_root,
                calendar=calendar,
                config=config,
                recovery_deadline_at=market_recovery_deadline,
            ),
            log_root=log_root,
            retry_on_busy=True,
            poll_seconds=poll_seconds,
        ),
        LaneJob(
            lane="calendar-daily-events",
            command=_lane_command(
                runner,
                "calendar-daily-events",
                market_date,
                stream=None,
                home=home,
                shadow_root=shadow_root,
                calendar=calendar,
                config=config,
            ),
            log_root=log_root,
        ),
        LaneJob(
            lane="intraday-1m",
            command=_lane_command(
                runner,
                "intraday-archive",
                market_date,
                stream="1m",
                home=home,
                shadow_root=shadow_root,
                calendar=calendar,
                config=config,
            ),
            log_root=log_root,
            retry_on_busy=True,
            poll_seconds=poll_seconds,
        ),
        LaneJob(
            lane="intraday-5m",
            command=_lane_command(
                runner,
                "intraday-archive",
                market_date,
                stream="5m",
                home=home,
                shadow_root=shadow_root,
                calendar=calendar,
                config=config,
            ),
            log_root=log_root,
            retry_on_busy=True,
            poll_seconds=poll_seconds,
        ),
    ]
    if time.monotonic() < deadline:
        existing = find_ready_daily_ods_lanes(
            release_root=release_root,
            market_date=market_date,
        )
        pending: list[LaneJob] = []
        for job in daily_group:
            verified = existing.get(_CATALOG_LANES[job.lane])
            if verified is None:
                pending.append(job)
                continue
            state["lanes"][job.lane] = {
                "status": (
                    "closed_session"
                    if job.lane != "calendar-daily-events"
                    and _closed_verified_release(verified, market_date)
                    else "ready"
                ),
                "returncode": 0,
                "attempts": 0,
                "logs": [],
                "source": "existing_ready_release",
                "release_id": verified.release.release_id,
                "release_path": str(verified.release_dir),
                "manifest_sha256": verified.manifest_sha256,
            }
        pending_by_lane = {job.lane: job for job in pending}
        if defer_one_minute:
            # A previously published minute READY is not T+1 admission on T;
            # hold that lane even if old release discovery found a legacy READY.
            pending_by_lane.pop("intraday-1m", None)
            state["lanes"]["intraday-1m"] = {
                "status": "deferred_source_maturity",
                "reason": "next_trading_session_minute_maturity_not_due",
                "attempts": 0,
                "returncode": None,
                "logs": [],
            }
        # Only the event lane is independent. The market and minute lanes share
        # pve_market_api, so run them in a deliberate order instead of lock racing.
        for lane_group in (
            ("market-daily-core", "calendar-daily-events"),
            ("intraday-5m",),
            ("intraday-1m",),
        ):
            jobs = [pending_by_lane[lane] for lane in lane_group if lane in pending_by_lane]
            if jobs:
                try:
                    results = _run_group(jobs, deadline=deadline, poll_seconds=poll_seconds)
                    for result in results.values():
                        if (
                            result.get("status") == "ready"
                            and result.get("logs")
                            and _closed_lane_receipt(Path(result["logs"][-1]), market_date)
                        ):
                            result["status"] = "closed_session"
                    state["lanes"].update(results)
                except (OSError, ProcessGroupCleanupError) as exc:
                    cleanup_failed = isinstance(exc, ProcessGroupCleanupError)
                    state["error_code"] = (
                        "process_cleanup_unconfirmed" if cleanup_failed else "lane_start_failed"
                    )
                    state["error"] = str(exc)
                    for pending_job in pending:
                        if pending_job.lane not in state["lanes"]:
                            status = "cleanup_failed" if cleanup_failed else "failed"
                            state["lanes"][pending_job.lane] = {
                                "status": status if pending_job.attempt else "not_started",
                                "returncode": (
                                    (PROCESS_CLEANUP_FAILED if cleanup_failed else 127)
                                    if pending_job.attempt
                                    else None
                                ),
                                "attempts": pending_job.attempt,
                                "logs": pending_job.logs,
                            }
                    break
    else:
        for job in daily_group:
            state["lanes"][job.lane] = {
                "status": "sla_exceeded",
                "returncode": None,
                "attempts": 0,
                "logs": [],
            }

    closed_session = (
        all(
            state["lanes"].get(lane, {}).get("status") == "closed_session"
            for lane in ("market-daily-core", "intraday-5m", "intraday-1m")
        )
        and state["lanes"].get("calendar-daily-events", {}).get("status") == "ready"
    )
    lane_success = all(item.get("status") == "ready" for item in state["lanes"].values())
    explicit_trading_session_defer = (
        defer_one_minute
        and state["lanes"].get("intraday-1m", {}).get("status") == "deferred_source_maturity"
        and all(
            state["lanes"].get(lane, {}).get("status") == "ready"
            for lane in ("market-daily-core", "calendar-daily-events", "intraday-5m")
        )
    )
    source_deferred = not lane_success and (
        explicit_trading_session_defer
        or source_maturity_deferred(
            state["lanes"], shadow_root=shadow_root, market_date=market_date
        )
    )
    if closed_session:
        state["catalog"] = {"status": "not_applicable_closed_session"}
        state["dwd"] = {"status": "not_applicable_closed_session"}
    elif lane_success:
        dwd_deadline = time.monotonic() + dwd_sla_seconds
        catalog_command = [
            str(catalog_builder),
            "--release-root",
            str(release_root),
            "--market-date",
            market_date.isoformat(),
            "--output",
            str(catalog_root),
        ]
        catalog_rc, catalog_log = _run_command(
            catalog_command,
            log_path=log_root / "catalog.log",
            timeout=_duration(dwd_deadline),
        )
        state["catalog"] = {
            "status": "ready" if catalog_rc == 0 else "failed",
            "returncode": catalog_rc,
            "root": str(catalog_root),
            "log": catalog_log,
        }
        if catalog_rc == 0:
            if args.ods_only:
                state["dwd"] = {"status": "not_requested"}
            dwd_base = Path(
                os.environ.get(
                    "QUANTHUS_DWD_BASE",
                    "/srv/quanthus/dwd-dws-v2/base/dwd-base-202607-v2.1",
                )
            )
            release_config = Path(
                os.environ.get(
                    "QUANTHUS_V2_RELEASE_CONFIG",
                    str(ROOT / "config/releases/v2-build202607.json"),
                )
            )
            dwd_daily_root = Path(
                os.environ.get(
                    "QUANTHUS_DWD_DAILY_ROOT",
                    "/srv/quanthus/dwd-dws-v2/daily",
                )
            )
            if not args.ods_only:
                dwd_command = [
                    str(dwd_python),
                    str(dwd_runner),
                    "--market-date",
                    market_date.isoformat(),
                    "--release-root",
                    str(release_root),
                    "--base",
                    str(dwd_base),
                    "--release-config",
                    str(release_config),
                    "--daily-root",
                    str(dwd_daily_root),
                ]
                dwd_rc, dwd_log = _run_command(
                    dwd_command,
                    log_path=log_root / "dwd-daily-build.log",
                    timeout=_duration(dwd_deadline),
                )
                state["dwd"] = {
                    "status": "ready" if dwd_rc == 0 else "failed",
                    "returncode": dwd_rc,
                    "log": dwd_log,
                    "daily_root": str(dwd_daily_root),
                }
    elif source_deferred:
        state["lanes"]["intraday-1m"]["status"] = "deferred_source_maturity"
        state["catalog"] = {"status": "deferred_source_maturity"}
        state["dwd"] = {"status": "deferred_source_maturity"}
        state["deferred_reason"] = (
            "1m collection scheduled for next verified trading-session maturity; "
            "no same-day source request was made"
            if explicit_trading_session_defer
            else (
                "Tencent 1m source failed exact qualification or a complete scan's "
                "daily volume/close checks; "
                "awaiting date-bounded maturity recovery"
            )
        )
    elif not lane_success:
        state["catalog"] = {"status": "blocked_by_lane_failure"}
        state["dwd"] = {"status": "blocked_by_lane_failure"}

    state["finished_at"] = _iso(_now())
    catalog_state = state.get("catalog") or {}
    dwd_state = state.get("dwd") or {}
    cleanup_failed = state.get("error_code") == "process_cleanup_unconfirmed" or any(
        item.get("returncode") == PROCESS_CLEANUP_FAILED
        for item in [*state["lanes"].values(), catalog_state, dwd_state]
    )
    if cleanup_failed:
        state["error_code"] = "process_cleanup_unconfirmed"
        state.setdefault(
            "error", "Owned process group cleanup could not be confirmed; retry prohibited"
        )
    ods_ready = lane_success and catalog_state.get("status") == "ready"
    fully_ready = ods_ready and dwd_state.get("status") == "ready"
    if closed_session:
        state["status"] = "closed_session"
    elif source_deferred:
        state["status"] = "deferred_source_maturity"
    elif args.ods_only and ods_ready:
        state["status"] = "ods_ready"
    else:
        state["status"] = "ready" if fully_ready else "failed"
    published = state["status"] in {"ready", "ods_ready"}
    successful = published or closed_session
    _write_run_state(run_root, state, ready=published)
    notification_context.update(
        {
            "status": state["status"],
            "finished_at": state["finished_at"],
        }
    )
    if successful:
        notification_context["error_code"] = None
        notification_context["error"] = None
    elif source_deferred:
        notification_context["error_code"] = "source_maturity_deferred"
        notification_context["error"] = state["deferred_reason"]
    elif state.get("error_code"):
        notification_context["error_code"] = state["error_code"]
        notification_context["error"] = state["error"]
    _atomic_json(notification_context_path, notification_context)
    print(json.dumps(state, ensure_ascii=True, sort_keys=True))
    if cleanup_failed:
        return PROCESS_CLEANUP_FAILED
    if source_deferred:
        return SOURCE_MATURITY_DEFERRED
    return 0 if successful else 2


if __name__ == "__main__":
    raise SystemExit(main())
