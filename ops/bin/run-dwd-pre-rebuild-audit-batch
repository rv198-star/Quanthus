#!/usr/bin/env python3
"""Run registered CN01 DWD pre-rebuild audits sequentially and resumably."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.dwd_pre_rebuild_audit_batch import (  # noqa: E402
    AUDIT_STEPS,
    DwdPreRebuildAuditBatchError,
    run_audit_batch,
)


def _evidence(value: str) -> tuple[str, Path]:
    name, separator, raw_path = value.partition("=")
    if not separator or not name or not raw_path:
        raise argparse.ArgumentTypeError("evidence must use STEP=/absolute/report.json")
    path = Path(raw_path)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("evidence report path must be absolute")
    return name, path


def _code_revision(repository: Path) -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=repository,
        check=False,
        capture_output=True,
        text=True,
    )
    revision = completed.stdout.strip()
    if completed.returncode or len(revision) != 40:
        raise DwdPreRebuildAuditBatchError("cannot resolve exact repository revision")
    return revision


def main() -> int:
    names = [step.name for step in AUDIT_STEPS]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, default=Path("."))
    parser.add_argument("--dwd-root", type=Path, required=True)
    parser.add_argument("--ods-root", type=Path)
    parser.add_argument("--plan-root", type=Path)
    parser.add_argument("--output-root", type=Path, required=True)
    parser.add_argument("--batch-id", required=True)
    parser.add_argument("--package-id", default="dwd-base-202607-v2")
    parser.add_argument("--memory-limit", default="2GB")
    parser.add_argument("--step", action="append", choices=names, dest="steps")
    parser.add_argument("--evidence", action="append", type=_evidence, default=[])
    args = parser.parse_args()
    evidence: dict[str, Path] = {}
    for name, path in args.evidence:
        if name in evidence:
            parser.error(f"duplicate evidence step: {name}")
        evidence[name] = path
    try:
        repository = args.repository.resolve()
        state = run_audit_batch(
            repository=repository,
            dwd_root=args.dwd_root,
            ods_root=args.ods_root,
            plan_root=args.plan_root,
            output_root=args.output_root,
            batch_id=args.batch_id,
            package_id=args.package_id,
            code_revision=_code_revision(repository),
            selected_steps=args.steps or names,
            evidence=evidence,
            memory_limit=args.memory_limit,
            required_output_ancestor=Path(
                "/personal/quanthus-cn01-build-scratch/"
                "dwd-base-202607-v2.1/pre-rebuild-audit"
            ),
        )
    except (DwdPreRebuildAuditBatchError, OSError) as exc:
        print(f"DWD pre-rebuild audit batch failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "batch_id": state["batch_id"],
                "status": state["status"],
                "remaining_audit_scope": state["remaining_audit_scope"],
                "state": str((args.output_root / args.batch_id / "batch-state.json").resolve()),
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
