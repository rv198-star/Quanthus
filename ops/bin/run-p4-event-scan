#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
PYTHON=${QUANTHUS_P4_PYTHON:-"$REPOSITORY_ROOT/.venv/bin/python"}
OUTPUT=${1:-"$REPOSITORY_ROOT/artifacts/p4/event-library-development"}

case "$OUTPUT" in
    /*) ;;
    *) OUTPUT="$REPOSITORY_ROOT/$OUTPUT" ;;
esac

if [ ! -x "$PYTHON" ]; then
    printf 'P4 Python is not executable: %s\n' "$PYTHON" >&2
    exit 2
fi

REVISION=$(git -C "$REPOSITORY_ROOT" rev-parse HEAD)
if [ -n "$(git -C "$REPOSITORY_ROOT" status --porcelain --untracked-files=no)" ]; then
    printf 'Refusing P4 physical scan from a dirty tracked worktree.\n' >&2
    exit 2
fi

export QUANTHUS_REPLAY_PROVIDER_DWD_ROOT=${QUANTHUS_REPLAY_PROVIDER_DWD_ROOT:-/srv/quanthus/dwd-dws-v2.1/base/dwd-base-202607-v2.1}
export QUANTHUS_REPLAY_PROVIDER_DWD_CORRECTION_ROOT=${QUANTHUS_REPLAY_PROVIDER_DWD_CORRECTION_ROOT:-/srv/quanthus/dwd-dws-v2.1/corrections/dwd-base-202607-v2.1-correction-20260813-001}

cd "$REPOSITORY_ROOT"
PYTHONPATH=src "$PYTHON" -m quanthus run-p4-event-scan \
    --source-policy config/p4-event-scan-source.research.v1.json \
    --provider-config config/replay-data-provider.development.v2.json \
    --rule-card config/p4-candidate-price-volume-transition.research.v1.json \
    --split-policy config/p4-event-split-policy.research.v1.json \
    --code-revision "$REVISION" \
    --output "$OUTPUT"

PYTHONPATH=src "$PYTHON" -m quanthus verify-p4-event-scan --root "$OUTPUT"
printf 'P4 event library: %s\n' "$OUTPUT"
