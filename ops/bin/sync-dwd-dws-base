#!/usr/bin/env bash
# Copy one immutable DWD/DWS Base pair through a node's write-only epoch jail.
set -euo pipefail

usage() {
  echo "usage: $0 --dwd-package PATH --dws-package PATH --remote-root PATH --host HOST --port PORT --user USER --key PATH --known-hosts PATH" >&2
}

dwd_package=""
dws_package=""
remote_root=""
remote_host=""
remote_port=""
remote_user=""
key_path=""
known_hosts=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dwd-package) dwd_package="${2:-}"; shift 2 ;;
    --dws-package) dws_package="${2:-}"; shift 2 ;;
    --remote-root) remote_root="${2:-}"; shift 2 ;;
    --host) remote_host="${2:-}"; shift 2 ;;
    --port) remote_port="${2:-}"; shift 2 ;;
    --user) remote_user="${2:-}"; shift 2 ;;
    --key) key_path="${2:-}"; shift 2 ;;
    --known-hosts) known_hosts="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

for package in "$dwd_package" "$dws_package"; do
  if [[ ! -d "$package" || ! -f "$package/manifest.json" || ! -f "$package/READY" ]]; then
    echo "local Base package is not sealed: $package" >&2
    exit 3
  fi
  package_id="${package%/}"
  package_id="${package_id##*/}"
  if [[ ! "$package_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$ ]]; then
    echo "Base package id contains unsupported characters" >&2
    exit 2
  fi
done
if [[ -z "$remote_root" || ! "$remote_root" =~ ^[A-Za-z0-9._/-]+$ ]]; then
  echo "remote root must be a safe path" >&2
  exit 2
fi
if [[ "/${remote_root#/}/" == *"/../"* || "$remote_root" == ".." ]]; then
  echo "remote root must not contain parent traversal" >&2
  exit 2
fi
if [[ ! "$remote_host" =~ ^[A-Za-z0-9.-]+$ || ! "$remote_port" =~ ^[0-9]{1,5}$ ]]; then
  echo "remote host or port is invalid" >&2
  exit 2
fi
if (( remote_port < 1 || remote_port > 65535 )) || [[ ! "$remote_user" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; then
  echo "remote port or user is invalid" >&2
  exit 2
fi
if [[ ! "$key_path" =~ ^/[A-Za-z0-9._/-]+$ || ! "$known_hosts" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
  echo "key and known-hosts paths must be safe absolute paths" >&2
  exit 2
fi
if [[ ! -f "$key_path" || ! -f "$known_hosts" ]]; then
  echo "SSH key or pinned known-hosts file is missing" >&2
  exit 2
fi
key_mode="$(stat -c '%a' "$key_path")"
if [[ "$key_mode" != "400" && "$key_mode" != "600" ]]; then
  echo "SSH key must have mode 0400 or 0600; got ${key_mode}" >&2
  exit 2
fi

ssh_command="ssh -i ${key_path} -p ${remote_port} -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${known_hosts}"
common=(
  -a
  --checksum
  --delay-updates
  --partial-dir=.rsync-partial
  --timeout=300
  --mkpath
  -e "$ssh_command"
)

sync_package() {
  local layer="$1"
  local package="$2"
  local package_id="${package%/}"
  package_id="${package_id##*/}"
  local destination="${remote_user}@${remote_host}:${remote_root%/}/dwd-dws-bases/${layer}/${package_id}/"
  rsync "${common[@]}" --ignore-existing --exclude=/READY "${package%/}/" "$destination"
  rsync "${common[@]}" --ignore-existing "${package%/}/READY" "${destination}READY"
}

sync_package dwd "$dwd_package"
sync_package dws "$dws_package"
echo "DWD/DWS Base pair push complete: remote=${remote_user}@${remote_host}"
