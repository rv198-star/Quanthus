#!/usr/bin/env bash
# Copy one immutable ODS Base to a hidden remote staging child, with optional hard-link reuse.
set -euo pipefail

usage() {
  echo "usage: $0 --bundle-id ID --local-base-root PATH --remote-base-root PATH --host HOST --port PORT --user USER --key PATH --known-hosts PATH [--link-dest ID]" >&2
}

bundle_id=""
local_base_root=""
remote_base_root=""
remote_host=""
remote_port=""
remote_user=""
key_path=""
known_hosts=""
link_dest=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bundle-id) bundle_id="${2:-}"; shift 2 ;;
    --local-base-root) local_base_root="${2:-}"; shift 2 ;;
    --remote-base-root) remote_base_root="${2:-}"; shift 2 ;;
    --host) remote_host="${2:-}"; shift 2 ;;
    --port) remote_port="${2:-}"; shift 2 ;;
    --user) remote_user="${2:-}"; shift 2 ;;
    --key) key_path="${2:-}"; shift 2 ;;
    --known-hosts) known_hosts="${2:-}"; shift 2 ;;
    --link-dest) link_dest="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

safe_id='^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$'
safe_path='^/[A-Za-z0-9._/-]+$'
if [[ ! "$bundle_id" =~ $safe_id || ( -n "$link_dest" && ! "$link_dest" =~ $safe_id ) ]]; then
  echo "bundle or link-dest id contains unsupported characters" >&2
  exit 2
fi
if [[ ! "$local_base_root" =~ $safe_path || ! "$remote_base_root" =~ $safe_path ]]; then
  echo "local and remote Base roots must be safe absolute paths" >&2
  exit 2
fi
if [[ "$local_base_root" == "/" || "$remote_base_root" == "/" ]]; then
  echo "filesystem root cannot be used as an ODS Base root" >&2
  exit 2
fi
if [[ ! "$remote_host" =~ ^[A-Za-z0-9.-]+$ || ! "$remote_port" =~ ^[0-9]{1,5}$ ]]; then
  echo "remote host or port is invalid" >&2
  exit 2
fi
if (( remote_port < 1 || remote_port > 65535 )); then
  echo "remote port is out of range" >&2
  exit 2
fi
if [[ ! "$remote_user" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; then
  echo "remote user is invalid" >&2
  exit 2
fi
if [[ ! "$key_path" =~ $safe_path || ! "$known_hosts" =~ $safe_path ]]; then
  echo "key and known-hosts paths must be safe absolute paths" >&2
  exit 2
fi
if [[ ! -f "$key_path" || ! -f "$known_hosts" ]]; then
  echo "SSH key or pinned known-hosts file is missing" >&2
  exit 2
fi

source_root="${local_base_root%/}/${bundle_id}"
if [[ ! -f "${source_root}/manifest.json" || ! -f "${source_root}/READY" ]]; then
  echo "local ODS Base is not ready: ${source_root}" >&2
  exit 3
fi
destination="${remote_user}@${remote_host}:${remote_base_root%/}/.incoming-${bundle_id}/"
ssh_command="ssh -i ${key_path} -p ${remote_port} -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${known_hosts}"
common=(
  -a
  --checksum
  --delay-updates
  --partial-dir=.rsync-partial
  --timeout=600
  --mkpath
  -e "$ssh_command"
)
if [[ -n "$link_dest" ]]; then
  common+=(--link-dest="../${link_dest}")
fi

rsync "${common[@]}" --exclude=/READY "${source_root}/" "$destination"
rsync "${common[@]}" "${source_root}/READY" "${destination}READY"

echo "ODS Base staged: bundle=${bundle_id} remote=${remote_user}@${remote_host}"
