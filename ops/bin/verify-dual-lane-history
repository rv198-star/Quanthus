#!/usr/bin/env python3
"""Verify a sealed history base and one lane-local merged catalog."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from quanthus.pipelines.dual_lane_history import (
    DualLaneHistoryError,
    load_history_base_current,
    load_history_base_policy,
    load_lane_history_current,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--storage-root", type=Path, required=True)
    parser.add_argument("--base-current", type=Path, required=True)
    parser.add_argument("--catalog-current", type=Path, required=True)
    args = parser.parse_args()
    try:
        policy = load_history_base_policy(args.policy)
        base = load_history_base_current(args.base_current, policy=policy)
        catalog = load_lane_history_current(
            args.catalog_current,
            storage_root=args.storage_root,
            policy=policy,
        )
        if catalog.base.manifest_sha256 != base.manifest_sha256:
            raise DualLaneHistoryError("catalog and base CURRENT select different bundles")
    except (DualLaneHistoryError, FileExistsError, OSError) as exc:
        print(f"dual-lane history verification failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "base_bundle_id": base.bundle_id,
                "base_content_digest": base.content_digest,
                "candidate_count": len(catalog.candidates),
                "catalog_id": catalog.catalog_id,
                "catalog_content_digest": catalog.content_digest,
                "lane_id": catalog.lane_id,
                "through_date": catalog.through_date.isoformat(),
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
