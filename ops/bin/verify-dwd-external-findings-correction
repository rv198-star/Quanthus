#!/usr/bin/env python3
"""Verify the immutable correction for DWD v2.1 external findings."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.securities_warehouse.dwd_correction import (  # noqa: E402
    DwdCorrectionError,
    verify_dwd_correction,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--parent", type=Path, required=True)
    parser.add_argument("--correction", type=Path, required=True)
    parser.add_argument("--deep", action="store_true")
    args = parser.parse_args()
    try:
        result = verify_dwd_correction(
            args.correction, parent=args.parent, deep=args.deep
        )
    except (DwdCorrectionError, OSError) as exc:
        print(f"DWD correction verification failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.to_dict(), ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
