#!/usr/bin/env python3
"""Verify one ODS Base package or active descriptor."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base import (
    OdsBaseError,
    load_ods_base_current,
    load_ods_base_policy,
    verify_ods_base_bundle,
)
from quanthus.pipelines.ods_monthly import MonthlyOdsError
from quanthus.pipelines.ods_monthly_input import open_monthly_input
from quanthus.pipelines.securities_warehouse.base22_bounded import BoundedError, Budget, Limits
from quanthus.pipelines.securities_warehouse.base22_sources import (
    SourceAssessmentError,
    disjoint_output,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    authority = parser.add_mutually_exclusive_group(required=True)
    authority.add_argument("--policy", type=Path)
    authority.add_argument("--monthly-consumer-contract", type=Path)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--bundle", type=Path)
    source.add_argument("--current", type=Path)
    parser.add_argument("--deep", action="store_true")
    parser.add_argument("--allow-staging-name", action="store_true")
    parser.add_argument("--monthly-audit-root", type=Path)
    parser.add_argument("--model", type=Path)
    parser.add_argument("--knowledge-cutoff")
    args = parser.parse_args()
    if args.allow_staging_name and args.bundle is None:
        parser.error("--allow-staging-name requires --bundle")
    if args.monthly_consumer_contract is not None:
        if (
            args.bundle is None
            or args.monthly_audit_root is None
            or args.model is None
            or args.knowledge_cutoff is None
            or args.allow_staging_name
        ):
            parser.error(
                "monthly verification requires sealed --bundle, --monthly-audit-root, "
                "--model and --knowledge-cutoff; no CURRENT or staging mode"
            )
        try:
            sources = [args.bundle, args.monthly_consumer_contract, args.model]
            scratch = disjoint_output(args.monthly_audit_root, sources)
            with Budget(
                scratch,
                sources,
                Limits(
                    allocated_bytes=256 * 1024**2,
                    temp_bytes=128 * 1024**2,
                    free_floor_bytes=8 * 1024**3,
                ),
            ) as budget:
                monthly = open_monthly_input(
                    root=args.bundle,
                    contract_path=args.monthly_consumer_contract,
                    model_path=args.model,
                    budget=budget,
                    knowledge_cutoff=args.knowledge_cutoff,
                )
            print(json.dumps(monthly.identity, sort_keys=True))
            return 0
        except (MonthlyOdsError, BoundedError, SourceAssessmentError, OSError) as exc:
            print(f"monthly ODS input verification failed: {exc}", file=sys.stderr)
            return 2
    if (
        args.monthly_audit_root is not None
        or args.model is not None
        or args.knowledge_cutoff is not None
    ):
        parser.error("monthly options require --monthly-consumer-contract")
    policy = load_ods_base_policy(args.policy)
    try:
        result = (
            verify_ods_base_bundle(
                args.bundle,
                policy=policy,
                deep=args.deep,
                allow_staging_name=args.allow_staging_name,
            )
            if args.bundle is not None
            else load_ods_base_current(args.current, policy=policy, deep=args.deep)
        )
    except (OdsBaseError, OSError) as exc:
        print(f"ODS Base verification failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "bundle_id": result.bundle_id,
                "content_digest": result.content_digest,
                "file_count": result.file_count,
                "manifest_sha256": result.manifest_sha256,
                "root": str(result.root),
                "size_bytes": result.size_bytes,
                "through_date": result.through_date.isoformat(),
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
