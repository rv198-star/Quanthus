#!/usr/bin/env python3
"""Verify an immutable ODS Base Hotfix and its exact parent binding."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base_hotfix import (
    OdsBaseHotfixError,
    verify_hotfix_bundle,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--parent-base", type=Path, required=True)
    parser.add_argument("--bundle", type=Path, required=True)
    parser.add_argument("--deep", action="store_true")
    args = parser.parse_args()
    try:
        result = verify_hotfix_bundle(
            args.bundle,
            parent_base=args.parent_base,
            deep=args.deep,
        )
    except (OdsBaseHotfixError, OSError) as exc:
        print(f"ODS Base Hotfix verification failed: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result.to_dict(), ensure_ascii=True, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
