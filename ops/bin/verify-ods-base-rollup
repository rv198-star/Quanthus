#!/usr/bin/env python3
"""Verify one self-contained ODS Base rollup."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from quanthus.pipelines.ods_base import load_ods_base_policy
from quanthus.pipelines.ods_base_rollup import (
    OdsBaseRollupError,
    verify_ods_base_rollup,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--policy", type=Path, required=True)
    parser.add_argument("--bundle", type=Path, required=True)
    parser.add_argument("--deep", action="store_true")
    args = parser.parse_args()
    try:
        result = verify_ods_base_rollup(
            args.bundle,
            policy=load_ods_base_policy(args.policy),
            deep=args.deep,
        )
    except (OdsBaseRollupError, OSError) as exc:
        print(f"ODS Base rollup verification failed: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "bundle_id": result.bundle_id,
                "content_digest": result.content_digest,
                "deep": args.deep,
                "file_count": result.file_count,
                "manifest_sha256": result.manifest_sha256,
                "root": str(result.root),
                "size_bytes": result.size_bytes,
                "through_date": result.through_date.isoformat(),
            },
            ensure_ascii=True,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
