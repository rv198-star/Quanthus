# Reuse the pinned runtime/collector; replace only a verified Git source bundle.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG PIPELINE_REVISION
USER root
COPY pipeline/ /opt/pipeline/
RUN python -c "from pathlib import Path; from quanthus.pipelines.securities_warehouse.container_code import verify_bundle; verify_bundle(Path(/opt/pipeline), )" \
    && chmod -R a-w /opt/pipeline
LABEL org.opencontainers.image.revision="${PIPELINE_REVISION}"
USER 998:998
