# Runtime env_file only. Provision privately on the host with mode 0600.
# Never COPY this populated file into a build context, commit it or use build ARG.
QUANTHUS_RESEND_API_KEY=REPLACE_WITH_EXISTING_AUTHORIZED_API_KEY
QUANTHUS_RESEND_FROM=report@mindthus.com
QUANTHUS_RESEND_TO=61718@qq.com
# Inclusive bounds: timeout 1..30 seconds; retries 0..1 (1..2 total attempts).
QUANTHUS_RESEND_TIMEOUT_SECONDS=15
QUANTHUS_RESEND_RETRIES=1
