# Install as /etc/quanthus/cn01-dwd.env with mode 0640.
QUANTHUS_CN01_ODS_RELEASE_ROOT=/root/work/astock/data/shadow/cn01-ods-v1/releases
QUANTHUS_ODS_BASE=/srv/quanthus/ods/base/ods-base-202607-v2
QUANTHUS_DWD_BASE=/srv/quanthus/dwd-dws-v2/base/dwd-base-202607-v2.1
QUANTHUS_V2_RELEASE_CONFIG=/root/work/Quanthus/config/releases/v2-build202607.json
QUANTHUS_DWD_RUN_ROOT=/srv/quanthus/dwd-dws-v2/runs
QUANTHUS_DWD_DAILY_ROOT=/srv/quanthus/dwd-dws-v2/daily
QUANTHUS_DWD_DAILY_WAIT_SECONDS=1800
QUANTHUS_DWD_WEEKLY_WAIT_SECONDS=21600
QUANTHUS_DWD_INPUT_POLL_SECONDS=30
# The daily ODS orchestrator invokes the actual DWD builder after its four-lane catalog gate.
# Fixed-time DWD timers remain disabled manual rollback paths.
QUANTHUS_DWD_ENV_FILE=/etc/quanthus/cn01-dwd.env
