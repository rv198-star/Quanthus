[Unit]
Description=Reclaim only successful expired owned P10 TMP

[Service]
Type=oneshot
User=agentdock
Group=agentdock
EnvironmentFile=/etc/quanthus/p10-container-host.env
WorkingDirectory=/opt/quanthus/p10-current
ExecStart=/opt/quanthus/p10-current/ops/bin/run-p10-container-job clean-tmp --deployment /etc/quanthus/p10-container-deployment.json --apply
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal
