# Install as /etc/quanthus/dual-lane-node.env owned by root:root with mode 0640 on CN01 and Hermes.
# Each node updates this checkout from GitHub with its own read-only deploy key.
# The candidate service uses group quanthus-candidate-ro with umask 0027; provision the
# candidate reader account in that group and keep the epoch writer account separate.
QUANTHUS_REPO_ROOT=/root/work/Quanthus
QUANTHUS_PYTHON=/root/work/Quanthus/.venv-p1/bin/python
QUANTHUS_CODE_REVISION=replace-with-deployed-40-character-git-commit
QUANTHUS_DUAL_LANE_CONFIG=/root/work/Quanthus/config/pipelines/dual-lane-dwd-dws.v1.json
# Set to cn01 on CN01 and hermes on Hermes.
QUANTHUS_DUAL_LANE_NODE_ID=hermes
QUANTHUS_DUAL_LANE_ODS_RELEASE_ROOT=/root/work/astock/data/shadow/hermes-ods-v1/releases
# The write-only account lands data in untrusted ingress. The root service verifies and promotes it
# to the sealed epoch root before candidate construction.
QUANTHUS_DUAL_LANE_EPOCH_INGRESS_ROOT=/srv/quanthus/dual-lane/epoch-incoming
QUANTHUS_DUAL_LANE_EPOCH_STAGING_ROOT=/srv/quanthus/dual-lane/epoch-staging
QUANTHUS_DUAL_LANE_EPOCH_ROOT=/srv/quanthus/dual-lane/epochs
QUANTHUS_DUAL_LANE_CANDIDATE_ROOT=/srv/quanthus/dual-lane/candidates
QUANTHUS_DUAL_LANE_STORAGE_ROOT=/srv/quanthus/dual-lane
QUANTHUS_DUAL_LANE_HISTORY_POLICY=/root/work/Quanthus/config/pipelines/dual-lane-history-base.v1.json
QUANTHUS_DUAL_LANE_HISTORY_BASE_ROOT=/srv/quanthus/dual-lane/history-bases
QUANTHUS_DUAL_LANE_HISTORY_BASE_CURRENT=/srv/quanthus/dual-lane/history-bases/CURRENT.json
QUANTHUS_DUAL_LANE_HISTORY_CATALOG_ROOT=/srv/quanthus/dual-lane/lane-history
# The catalog runner automatically switches to this monthly Base pair only when both descriptors
# exist and verify. Until then it retains the sealed history-base path above.
QUANTHUS_PLATFORM_ROOT=/srv/quanthus
QUANTHUS_DWD_DWS_BASE_POLICY=/root/work/Quanthus/config/pipelines/dwd-dws-base-through-20260730.v2.json
QUANTHUS_DWD_BASE_ROOT=/srv/quanthus/dwd/base
QUANTHUS_DWS_BASE_ROOT=/srv/quanthus/dws/base
QUANTHUS_DWD_BASE_CURRENT=/srv/quanthus/dwd/base/BASE_CURRENT.json
QUANTHUS_DWS_BASE_CURRENT=/srv/quanthus/dws/base/BASE_CURRENT.json
QUANTHUS_DUAL_LANE_EPOCH_USER=quanthus-epoch-in
QUANTHUS_DUAL_LANE_CANDIDATE_USER=quanthus-candidate-ro
QUANTHUS_DUAL_LANE_INPUT_WAIT_SECONDS=600
QUANTHUS_DUAL_LANE_INPUT_POLL_SECONDS=10
