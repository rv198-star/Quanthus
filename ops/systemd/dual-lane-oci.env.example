# Install as /etc/quanthus/dual-lane-oci.env owned by root:ubuntu with mode 0640.
# Repository code reaches every node only through its node-local GitHub checkout.
QUANTHUS_REPO_ROOT=/opt/quanthus/current
QUANTHUS_PYTHON=/opt/quanthus/current/.venv/bin/python
QUANTHUS_CODE_REVISION=replace-with-deployed-40-character-git-commit
QUANTHUS_DUAL_LANE_CONFIG=/opt/quanthus/current/config/pipelines/dual-lane-dwd-dws.v1.json
QUANTHUS_DUAL_LANE_EPOCH_ROOT=/home/ubuntu/data/quanthus/dual-lane/epochs
QUANTHUS_DUAL_LANE_INCOMING_ROOT=/home/ubuntu/data/quanthus/dual-lane/incoming
QUANTHUS_DUAL_LANE_PUBLICATION_ROOT=/home/ubuntu/data/quanthus/dual-lane/publication
QUANTHUS_DUAL_LANE_PUBLISHER_LOCK=/home/ubuntu/data/quanthus/locks/t-close-plus-5h.lock
QUANTHUS_DUAL_LANE_RELEASE_SET_CURRENT=/home/ubuntu/data/quanthus/dual-lane/publication/release-set_CURRENT.json
QUANTHUS_DUAL_LANE_UNIVERSE_POLICY=/opt/quanthus/current/config/p1-universe.v2.json
QUANTHUS_DUAL_LANE_CODE_VALIDITY=/opt/quanthus/current/config/security-code-validity.v1.json
QUANTHUS_DUAL_LANE_SECURITY_MASTER=/home/ubuntu/data/astock/ref_security_master.parquet
# Set exactly one canonical source. Normal daily operation uses the parent pointer.
QUANTHUS_DUAL_LANE_PARENT_POINTER=/home/ubuntu/data/quanthus/revisions/daily_market_CURRENT.json
# QUANTHUS_DUAL_LANE_BASE_POINTER=/home/ubuntu/data/quanthus/revisions/daily_ohlcv_none_CURRENT.json
QUANTHUS_DUAL_LANE_PULL_ATTEMPTS=20
QUANTHUS_DUAL_LANE_PULL_INTERVAL_SECONDS=15

# Use separate forced-command data identities. Do not reuse either node's Git deploy key.
# Epoch authorized_keys: command="/usr/bin/rrsync -wo -no-del /srv/quanthus/dual-lane/epoch-incoming"
# Candidate authorized_keys: command="/usr/bin/rrsync -ro /srv/quanthus/dual-lane/candidates"
# Add no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding to both keys.
# With those jails, the rsync-visible remote root is '.'.
QUANTHUS_CN01_DUAL_LANE_HOST=replace-with-cn01-host
QUANTHUS_CN01_DUAL_LANE_PORT=22
QUANTHUS_CN01_DUAL_LANE_EPOCH_USER=quanthus-epoch-in
QUANTHUS_CN01_DUAL_LANE_EPOCH_KEY=/home/ubuntu/.ssh/cn01_epoch_in
QUANTHUS_CN01_DUAL_LANE_CANDIDATE_USER=quanthus-candidate-ro
QUANTHUS_CN01_DUAL_LANE_CANDIDATE_KEY=/home/ubuntu/.ssh/cn01_candidate_ro
QUANTHUS_CN01_DUAL_LANE_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts_cn01_dual_lane
QUANTHUS_CN01_DUAL_LANE_EPOCH_ROOT=.
QUANTHUS_CN01_DUAL_LANE_CANDIDATE_ROOT=.

QUANTHUS_HERMES_DUAL_LANE_HOST=127.0.0.1
QUANTHUS_HERMES_DUAL_LANE_PORT=2222
QUANTHUS_HERMES_DUAL_LANE_EPOCH_USER=quanthus-epoch-in
QUANTHUS_HERMES_DUAL_LANE_EPOCH_KEY=/home/ubuntu/.ssh/hermes_epoch_in
QUANTHUS_HERMES_DUAL_LANE_CANDIDATE_USER=quanthus-candidate-ro
QUANTHUS_HERMES_DUAL_LANE_CANDIDATE_KEY=/home/ubuntu/.ssh/hermes_candidate_ro
QUANTHUS_HERMES_DUAL_LANE_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts_hermes_dual_lane
QUANTHUS_HERMES_DUAL_LANE_EPOCH_ROOT=.
QUANTHUS_HERMES_DUAL_LANE_CANDIDATE_ROOT=.
