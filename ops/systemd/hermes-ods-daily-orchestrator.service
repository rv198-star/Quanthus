[Unit]
Description=Quanthus ODS-to-DWD daily four-lane orchestrator (READY-gated)
After=network-online.target
Wants=network-online.target
OnFailure=hermes-dwd-failure-notification.service quanthus-pipeline-failure@%n.service
OnSuccess=hermes-dwd-success-notification.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
EnvironmentFile=-/etc/quanthus/hermes-dwd.env
Environment=HERMES_ODS_NODE_ID=hermes
Environment=HERMES_ODS_ENV_FILE=/etc/quanthus/hermes-ods-lane.env
WorkingDirectory=/root/work/Quanthus
Environment=QUANTHUS_ODS_DAILY_MAX_ATTEMPTS=2
Environment=QUANTHUS_ODS_DAILY_RETRY_DELAY_SECONDS=600
Environment=QUANTHUS_ODS_DAILY_RETRY_RECOVERY_SECONDS=14760
ExecCondition=/root/work/Quanthus/ops/bin/check-ods-orchestrator-window --node-id hermes
ExecStart=/root/work/Quanthus/ops/bin/run-ods-daily-with-retry /root/work/Quanthus/ops/bin/run-cn01-ods-daily
TimeoutStartSec=540min
SuccessExitStatus=0
Nice=5
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
