[Unit]
Description=Hermes ODS intraday-archive 1m stream (shadow-safe, research)
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
WorkingDirectory=/root/work/Quanthus
ExecStart=/bin/bash -lc 'set -euo pipefail; \
  MD="${MARKET_DATE:-$(TZ=Asia/Shanghai date -d "yesterday" +%F)}"; \
  /root/work/Quanthus/ops/bin/run-hermes-ods-lane --lane intraday-archive --stream 1m --market-date "$MD"'
Nice=15
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
