# Copy to /etc/quanthus/hermes-ods-lane.env (mode 0640) before enabling timers.
# The rendered market service sets this to hermes or cn01 for A/B evidence.
# HERMES_ODS_NODE_ID=hermes
# CN01 keeps the earlier schedule profile in /etc/quanthus/cn01-ods-lane.env.
HERMES_ODS_DAILY_SLA_SECONDS=5400
QUANTHUS_DWD_DAILY_SLA_SECONDS=3600
HERMES_ODS_ORCHESTRATOR_POLL_SECONDS=15
ASTOCK_ROOT=/root/work/astock
ASTOCK_HOME=/root/work/astock/data
HERMES_ODS_SHADOW_ROOT=/root/work/astock/data/shadow/hermes-ods-v1
HERMES_ODS_CALENDAR=/root/work/astock/data/ref_trading_calendar.parquet
# Point at the installed schedule contract after checkout.
HERMES_ODS_SCHEDULE=/root/work/Quanthus/config/schedules/hermes-ods-schedule.late.v1.json
# Fail-closed acquire mode: must be explicit provider|local (no auto).
# Production shadow / Hermes host: provider. Unit tests: local.
HERMES_ODS_ACQUIRE_MODE=provider
# Explicit argv-only collector map. Provider events/weekly fail closed when absent.
HERMES_ODS_PROVIDER_SPEC=/etc/quanthus/hermes-provider-collectors.v1.json
ASTOCK_FUNDAMENTALS_PYTHON=/root/work/astock/.venv/bin/python
ASTOCK_TDX_PYTHON=/root/work/astock/.venv-a-stock-data/bin/python
# Minute collection defaults to the repository module
# quanthus.providers.minute_tdx. Set this only for a controlled external fork.
# HERMES_ODS_MINUTE_COLLECTOR=/opt/quanthus-providers/minute_tdx.py
# The governed Tencent 1m path requires a same-date READY market release and
# preserves exact-null minute amount. Full-universe HTTP collection needs a
# bounded 3600s child allowance below the 4-hour systemd service limit.
HERMES_ODS_MINUTE_TENCENT_FALLBACK=1
HERMES_ODS_MINUTE_SLEEP=0.18
HERMES_ODS_MINUTE_TIMEOUT_SEC=3600
# Optional: bound universe for smoke. Intraday output is marked smoke_only and
# cannot publish READY while this is set; omit for full in-scope universe.
# HERMES_ODS_SYMBOL_LIMIT=50
# Event disclose-date lookback / re-sweep window (days).
HERMES_ODS_EVENT_LOOKBACK_DAYS=7
# Shadow Phase B default market dates (override per run).
OPEN_DATE=2026-07-24
CLOSED_DATE=2026-07-25
WEEKLY_DATE=2026-07-24
EVENT_DATE=2026-07-24
