# Copy to /etc/quanthus/hermes-ods-lane.env (mode 0640) before enabling timers.
ASTOCK_ROOT=/root/work/astock
ASTOCK_HOME=/root/work/astock/data
HERMES_ODS_SHADOW_ROOT=/root/work/astock/data/shadow/hermes-ods-v1
HERMES_ODS_CALENDAR=/root/work/astock/data/ref_trading_calendar.parquet
# Point at the installed schedule contract after checkout.
HERMES_ODS_SCHEDULE=/root/work/Quanthus/config/schedules/hermes-ods-schedule.v1.json
# Shadow Phase B default market dates (override per run).
OPEN_DATE=2026-07-24
CLOSED_DATE=2026-07-25
WEEKLY_DATE=2026-07-24
EVENT_DATE=2026-07-24
