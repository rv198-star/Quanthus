[Unit]
Description=Hermes ODS market-daily-core lane (shadow-safe)
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
Environment=HERMES_ODS_NODE_ID=hermes
WorkingDirectory=/root/work/Quanthus
# A restarted calendar timer can re-activate today's elapsed event. Skip it outside this node's window.
ExecCondition=/root/work/Quanthus/ops/bin/check-ods-collection-window --node-id hermes
# Post-close timer fires same Asia/Shanghai calendar day as market_date.
ExecStart=/bin/bash -lc 'set -euo pipefail;   MD="${MARKET_DATE:-$(TZ=Asia/Shanghai date +%%F)}";   /root/work/Quanthus/ops/bin/run-hermes-ods-lane --lane market-daily-core --market-date "$MD"'
Nice=5
TimeoutStartSec=4h10min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
