[Unit]
Description=Hermes ODS market-daily-core lane (shadow-safe)
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
WorkingDirectory=/root/work/Quanthus
# MARKET_DATE must be supplied by the timer Environment= or a manual start.
# Default: previous Asia/Shanghai calendar day is computed by the wrapper if unset.
ExecStart=/bin/bash -lc 'set -euo pipefail; \
  MD="${MARKET_DATE:-$(TZ=Asia/Shanghai date -d "yesterday" +%F)}"; \
  /root/work/Quanthus/ops/bin/run-hermes-ods-lane --lane market-daily-core --market-date "$MD"'
Nice=5
TimeoutStartSec=5h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
