[Unit]
Description=Hermes ODS shadow staging retention (release and DWD gated)
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
WorkingDirectory=/root/work/Quanthus
ExecStart=/root/work/Quanthus/ops/bin/prune-ods-shadow --node-id hermes --shadow-root ${HERMES_ODS_SHADOW_ROOT} --failed-bulk-days 3 --audit-days 90 --apply
Nice=10
UMask=0027
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
