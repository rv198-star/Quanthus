[Unit]
Description=Hermes ODS weekly-corrections lane (shadow-safe)
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/quanthus/hermes-ods-lane.env
WorkingDirectory=/root/work/Quanthus
ExecStart=/bin/bash -lc 'set -euo pipefail; \
  MD="${MARKET_DATE:-$(TZ=Asia/Shanghai date +%F)}"; \
  /root/work/Quanthus/ops/bin/run-hermes-ods-lane --lane weekly-corrections --market-date "$MD"'
Nice=10
TimeoutStartSec=6h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
