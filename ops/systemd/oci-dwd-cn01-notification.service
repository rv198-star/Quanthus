[Unit]
Description=Email the CN01 DWD completion notification
After=oci-dwd-daily-sync.service
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/quanthus/oci-dwd-sync.env
WorkingDirectory=/opt/quanthus/current
ExecStart=${QUANTHUS_PYTHON} /opt/quanthus/current/ops/bin/notify-dwd-event --event cn01_dwd_completed
TimeoutStartSec=2min
NoNewPrivileges=true
UMask=0027
