[Unit]
Description=Pull and verify the latest CN01 DWD daily increment on OCI
After=network-online.target
Wants=network-online.target
OnFailure=oci-dwd-sync-failure-notification.service quanthus-pipeline-failure@%n.service
OnSuccess=oci-dwd-sync-notification.service
StartLimitIntervalSec=6h
StartLimitBurst=2

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/quanthus/t-close-plus-5h.env
EnvironmentFile=-/etc/quanthus/oci-dwd-sync.env
Environment=QUANTHUS_OCI_DWD_LOCAL_ROOT=/home/ubuntu/data/quanthus/dwd-daily
Environment=QUANTHUS_CN01_DWD_HOST=39.98.85.149
Environment=QUANTHUS_CN01_DWD_PORT=22
Environment=QUANTHUS_CN01_DWD_USER=quanthus-dwd-ro
Environment=QUANTHUS_CN01_DWD_KEY=/home/ubuntu/.ssh/cn01_candidate_ro
Environment=QUANTHUS_CN01_DWD_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts_cn01_dual_lane
Environment=QUANTHUS_CN01_DWD_REMOTE_ROOT=.
Environment=QUANTHUS_NOTIFICATION_STATE_ROOT=/home/ubuntu/data/quanthus/notifications
Environment=QUANTHUS_DWD_FAILURE_RECEIPT=/home/ubuntu/data/quanthus/dwd-daily/failures/LATEST.json
Environment=QUANTHUS_NODE=OCI
Environment=QUANTHUS_SYSTEMD_UNIT=oci-dwd-daily-sync.service
WorkingDirectory=/opt/quanthus/current
ExecStart=/opt/quanthus/current/.venv/bin/python /opt/quanthus/current/ops/bin/sync-cn01-dwd-daily --wait-seconds 5400 --poll-seconds 60 --max-attempts 3
TimeoutStartSec=100min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
