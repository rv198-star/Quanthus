[Unit]
Description=Email the OCI DWD synchronization failure notification
After=oci-dwd-daily-sync.service
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/quanthus/t-close-plus-5h.env
EnvironmentFile=-/etc/quanthus/oci-dwd-sync.env
Environment=QUANTHUS_OCI_DWD_LOCAL_ROOT=/home/ubuntu/data/quanthus/dwd-daily
Environment=QUANTHUS_DWD_FAILURE_RECEIPT=/home/ubuntu/data/quanthus/dwd-daily/failures/LATEST.json
Environment=QUANTHUS_NOTIFICATION_STATE_ROOT=/home/ubuntu/data/quanthus/notifications
Environment=QUANTHUS_NODE=OCI
Environment=QUANTHUS_SYSTEMD_UNIT=oci-dwd-daily-sync.service
WorkingDirectory=/opt/quanthus/current
ExecStart=/opt/quanthus/current/.venv/bin/python /opt/quanthus/current/ops/bin/notify-dwd-failure
TimeoutStartSec=2min
NoNewPrivileges=true
UMask=0027
