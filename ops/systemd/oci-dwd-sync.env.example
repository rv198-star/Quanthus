# Install as /etc/quanthus/oci-dwd-sync.env owned by root:ubuntu, mode 0640.
QUANTHUS_REPO_ROOT=/opt/quanthus/current
QUANTHUS_PYTHON=/opt/quanthus/current/.venv/bin/python
QUANTHUS_OCI_DWD_LOCAL_ROOT=/home/ubuntu/data/quanthus/dwd-daily
QUANTHUS_CN01_DWD_HOST=39.98.85.149
QUANTHUS_CN01_DWD_PORT=22
QUANTHUS_CN01_DWD_USER=quanthus-dwd-ro
QUANTHUS_CN01_DWD_KEY=/home/ubuntu/.ssh/cn01_candidate_ro
QUANTHUS_CN01_DWD_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts_cn01_dual_lane
QUANTHUS_CN01_DWD_REMOTE_ROOT=.
QUANTHUS_NOTIFICATION_STATE_ROOT=/home/ubuntu/data/quanthus/notifications
QUANTHUS_RESEND_API_KEY=replace-with-resend-api-key
QUANTHUS_RESEND_FROM=report@mindthus.com
QUANTHUS_RESEND_TO=61718@qq.com
QUANTHUS_RESEND_TIMEOUT_SECONDS=15
QUANTHUS_RESEND_RETRIES=2
