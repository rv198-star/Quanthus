[Unit]
Description=Quanthus lane-local DWD/DWS candidate build
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service
OnSuccess=quanthus-dual-lane-history-catalog.service

[Service]
Type=oneshot
User=root
Group=quanthus-candidate-ro
EnvironmentFile=/etc/quanthus/dual-lane-node.env
WorkingDirectory=/root/work/Quanthus
ExecStart=/root/work/Quanthus/ops/bin/run-dual-lane-candidate-build
TimeoutStartSec=40min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
