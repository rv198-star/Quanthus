[Unit]
Description=Quanthus DWD Base V2.1 rebuild health snapshot
ConditionPathIsMountPoint=/srv/quanthus/gpu-p100-dwd-workspace
After=local-fs.target

[Service]
Type=oneshot
User=rv192
Group=rv192
WorkingDirectory=/home/rv192/work/Quanthus-issue78-audit-closure
EnvironmentFile=/etc/quanthus/gpu-p100-dwd-rebuild.env
Environment=PYTHONPATH=/home/rv192/work/Quanthus-issue78-audit-closure/src
ExecStart=/home/rv192/work/Quanthus-issue78-audit-closure/.venv-dwd-rebuild/bin/python /home/rv192/work/Quanthus-issue78-audit-closure/ops/bin/inspect-dwd-v2-1-rebuild --contract /home/rv192/work/Quanthus-issue78-audit-closure/config/audits/dwd-base-v2-1-gpu-p100-execution.v1.json --expected-contract-digest ${QUANTHUS_DWD_EXECUTION_CONTRACT_DIGEST} --workspace /srv/quanthus/gpu-p100-dwd-workspace --minimum-free-bytes ${QUANTHUS_DWD_MONITOR_MINIMUM_FREE_BYTES} --output-root /srv/quanthus/gpu-p100-dwd-workspace/control/monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/quanthus/gpu-p100-dwd-workspace/control/monitor
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
