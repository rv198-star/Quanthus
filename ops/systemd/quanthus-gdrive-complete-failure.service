[Unit]
Description=CN01 GDrive archive service failure or timeout email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/quanthus/data-delivery-current
EnvironmentFile=/etc/quanthus/dwd-notification.env
Environment=PYTHONPATH=/opt/quanthus/data-delivery-current/src
ExecStart=/root/work/Quanthus/.venv-p1/bin/python -m quanthus.pipelines.p10_complete_daily_notifications --archive-service-failure
TimeoutStartSec=2min
MemoryMax=512M
NoNewPrivileges=true
UMask=0077
