[Unit]
Description=P10 cn01-minute-T verified data/quality email checkpoint

[Timer]
OnCalendar=Mon..Fri *-*-* 21:50:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 22:10:00 Asia/Shanghai
AccuracySec=1min
Persistent=false
Unit=quanthus-p10-deadline@cn01-minute-T.service

[Install]
WantedBy=timers.target
