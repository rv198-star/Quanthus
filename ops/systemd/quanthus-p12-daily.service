[Unit]
Description=Quanthus P12 daily advice package (isolated 8791)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The job root binds the CN02 base24 daily-cycle pointer; the state dir holds
# the isolated paper ledger, published packages and run receipts.
Environment=QUANTHUS_P12_DAILY_JOB_ROOT=/srv/quanthus-base22-data/jobs/cn02-standard-daily-base251-a5
Environment=PYTHONPATH=/opt/quanthus/p12-acceptance/current
ExecStart=/usr/bin/python3 -m quanthus.p12_daily.daily_job \
    --state-dir /var/lib/quanthus-p12-isolated \
    --account SYN-PAPER-A \
    --market-date %E{P12_MARKET_DATE} \
    --next-session %E{P12_NEXT_SESSION}
# Market dates are supplied by the wrapper ops/bin/p12-daily-run (computes the
# latest completed session and the next trading day) or by a drop-in env file.
TimeoutStartSec=1800
