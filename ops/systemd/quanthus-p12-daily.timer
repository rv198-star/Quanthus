[Unit]
Description=Nightly P12 daily advice run (isolated 8791)

[Timer]
# Issue #719 publish-time rule: runs before the configured decision cutoff
# (22:30+08) only do a precheck; the package publishes after the cutoff.  The
# 20/21/22 slots are precheck passes inside the job window; 22:35 is the
# post-cutoff publish slot, with 22:45 and 23:00 as bounded retries.
OnCalendar=*-*-* 20:00:00 Asia/Shanghai
OnCalendar=*-*-* 21:00:00 Asia/Shanghai
OnCalendar=*-*-* 22:00:00 Asia/Shanghai
OnCalendar=*-*-* 22:35:00 Asia/Shanghai
OnCalendar=*-*-* 22:45:00 Asia/Shanghai
OnCalendar=*-*-* 23:00:00 Asia/Shanghai
Persistent=true

[Install]
WantedBy=timers.target
