[Unit]
Description=Quanthus T-close plus 5h daily warehouse pipeline
After=network-online.target
Wants=network-online.target
OnFailure=quanthus-pipeline-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/quanthus/t-close-plus-5h.env
WorkingDirectory=/opt/quanthus/current
ExecStart=/opt/quanthus/current/ops/bin/run-t-close-plus-5h
TimeoutStartSec=6h
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
